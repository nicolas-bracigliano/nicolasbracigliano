{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // `true` restores the astro/strictest base behaviour. Node 24's
    // TS-strip loader (used by `scripts/smoke-routes.ts`) requires
    // explicit `.ts` extensions in imports — `noEmit` is on, so this
    // flag is safe (the compiler doesn't have to invent output paths).
    "allowImportingTsExtensions": true,
    // TS 6 deprecated `baseUrl`; declare it explicitly so paths still resolve
    // relative to the project root, and silence the deprecation warning.
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@layouts/*": ["src/layouts/*"],
      "@components/*": ["src/components/*"],
      "@styles/*": ["src/styles/*"]
    },
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": [".astro/types.d.ts", ".astro/content.d.ts", ".astro/integrations.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "tests/e2e", ".astro/collections"]
}
