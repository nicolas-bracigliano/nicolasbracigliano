{
  "name": "nicolasbracigliano-com",
  "version": "1.6.1",
  "private": true,
  "description": "Personal site — colophon, bilingual (en/es), Astro + Cloudflare Pages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:fn": "astro build && wrangler pages dev ./dist --compatibility-date=2026-05-01",
    "typecheck": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "subset-fonts": "node scripts/subset-fonts.mjs",
    "postbuild": "pagefind --site dist --output-subdir _pagefind"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.2",
    "astro": "6.3.7",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.11.3",
    "@cloudflare/vitest-pool-workers": "0.16.8",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.60.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.6.0",
    "html-validate": "11.2.0",
    "lefthook": "2.1.8",
    "license-checker": "25.0.1",
    "lightningcss": "1.32.0",
    "pagefind": "1.5.2",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "satori": "0.26.0",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "wrangler": "4.93.1"
  }
}
