{
  "name": "nicolasbracigliano-com",
  "version": "1.26.13",
  "private": true,
  "description": "Bilingual personal site built with Astro 7 and Cloudflare Workers Static Assets.",
  "homepage": "https://nicolasbracigliano.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolas-bracigliano/nicolasbracigliano.git"
  },
  "bugs": {
    "url": "https://github.com/nicolas-bracigliano/nicolasbracigliano/issues"
  },
  "author": "Nicolás Bracigliano <me@nicolasbracigliano.com> (https://nicolasbracigliano.com)",
  "keywords": [
    "astro",
    "cloudflare-workers",
    "typescript",
    "bilingual",
    "static-site",
    "personal-website",
    "design-system",
    "csp"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "astro dev",
    "dev:bg": "astro dev --background",
    "build": "astro build",
    "preview": "astro preview",
    "dev:fn": "astro build && wrangler dev",
    "typecheck": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:actions": "scripts/lint-workflow-pins.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new": "node scripts/new-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "lhci:pr-config": "node scripts/lighthouse-pr-config.mjs",
    "subset-fonts": "node scripts/subset-fonts.mjs",
    "verify:fast": "pnpm typecheck && pnpm lint && pnpm lint:actions && pnpm format:check && pnpm test",
    "verify:slow": "pnpm build && pnpm exec html-validate \"dist/**/*.html\" && pnpm test:e2e && pnpm lhci",
    "verify": "pnpm verify:fast && pnpm verify:slow"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "25.9.9",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "lefthook": "2.2.2",
    "license-checker": "25.0.1",
    "lightningcss": "1.33.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "satori": "0.60.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.0",
    "yaml": "2.9.1"
  }
}
