{
  "name": "nicolasbracigliano-com",
  "version": "1.24.5",
  "private": true,
  "description": "Personal site — colophon, bilingual (en/es), Astro 7 on Cloudflare Workers Static Assets.",
  "homepage": "https://nicolasbracigliano.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolas-bracigliano/nicolasbracigliano.git"
  },
  "bugs": {
    "url": "https://github.com/nicolas-bracigliano/nicolasbracigliano/issues"
  },
  "author": "Nicolás Bracigliano <me@nicolasbracigliano.com> (https://nicolasbracigliano.com)",
  "keywords": [
    "astro",
    "cloudflare-workers",
    "typescript",
    "bilingual",
    "static-site",
    "personal-website",
    "design-system",
    "csp"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "astro dev",
    "dev:bg": "astro dev --background",
    "build": "astro build",
    "preview": "astro preview",
    "dev:fn": "astro build && wrangler dev",
    "typecheck": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:actions": "scripts/lint-workflow-pins.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new": "node scripts/new-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "lhci:pr-config": "node scripts/lighthouse-pr-config.mjs",
    "subset-fonts": "node scripts/subset-fonts.mjs",
    "verify:fast": "pnpm typecheck && pnpm lint && pnpm lint:actions && pnpm format:check && pnpm test",
    "verify:slow": "pnpm build && pnpm exec html-validate \"dist/**/*.html\" && pnpm test:e2e && pnpm lhci",
    "verify": "pnpm verify:fast && pnpm verify:slow"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vitest-pool-workers": "0.16.18",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "25.9.5",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "10.4.1",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.7.0",
    "html-validate": "11.5.6",
    "lefthook": "2.1.10",
    "license-checker": "25.0.1",
    "lightningcss": "1.33.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "satori": "0.26.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.112.0",
    "yaml": "2.9.0"
  }
}
