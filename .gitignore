# Playwright MCP scratch screenshots from interactive debugging.
# Explicit prefixes only — `/*.png` would silently hide any legit
# root-level PNG (logo, OG override, etc).
.playwright-mcp/
/notes-*.png
/page-*.png
/colophon-*.png
/works-*.png
