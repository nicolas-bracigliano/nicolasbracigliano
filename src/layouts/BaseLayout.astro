---
import '@styles/reset.css';
import '@styles/tokens.css';
import '@styles/base.css';
import '@styles/animations.css';
import { ClientRouter } from 'astro:transitions';
import { ROUTES, type Locale } from '@lib/routes';

export interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Current page path (e.g. "/en/notes/hello/") */
  path: string;
  /** Sibling path in the other locale, or null if there is no published translation */
  siblingPath: string | null;
  /** Optional override for OG image (absolute URL or path under site origin) */
  ogImage?: string;
}

const { title, description, locale, path, siblingPath, ogImage } = Astro.props;
const site = Astro.site?.toString() ?? 'https://nicolasbracigliano.com';
const origin = site.replace(/\/$/, '');

const enHref = locale === 'en' ? path : (siblingPath ?? path);
const esHref = locale === 'es' ? path : (siblingPath ?? path);

const toggleDisabled = siblingPath === null;

const navItems: Array<{ key: keyof typeof ROUTES; label: string }> =
  locale === 'en'
    ? [
        { key: 'notes', label: 'notes' },
        { key: 'works', label: 'works' },
        { key: 'about', label: 'about' },
        { key: 'colophon', label: 'colophon' },
      ]
    : [
        { key: 'notes', label: 'notas' },
        { key: 'works', label: 'obras' },
        { key: 'about', label: 'sobre' },
        { key: 'colophon', label: 'colofón' },
      ];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={`${origin}${path}`} />
    <link rel="alternate" hreflang="en" href={`${origin}${enHref}`} />
    <link rel="alternate" hreflang="es" href={`${origin}${esHref}`} />
    <link rel="alternate" hreflang="x-default" href={`${origin}${enHref}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={`${origin}${path}`} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_AR'} />
    {
      ogImage && (
        <meta
          property="og:image"
          content={ogImage.startsWith('http') ? ogImage : `${origin}${ogImage}`}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* FOUC-prevention: external file so CSP can stay `script-src 'self'` with no hashes. */}
    <script is:inline src="/theme-init.js"></script>

    {
      /* Native View Transitions API for cross-page navigation. ~3 KB once,
        cached after first page. No SPA — every page still server-rendered
        and indexable. Animation choreography lives in animations.css. */
    }
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    {
      /* `transition:animate="none"` keeps the chrome visually stable during
        ClientRouter navigations — the page body fades to the new content
        but the chrome doesn't fade with it. Attributes inside (aria-current
        on nav, href/aria-disabled on lang toggle) still update because
        the chrome re-renders; only its animation opts out. */
    }
    <header class="chrome" transition:animate="none">
      <a
        href={ROUTES.home[locale]}
        class="mark"
        aria-label={locale === 'en' ? 'Home' : 'Inicio'}
        transition:name="mark"
      >
        <span aria-hidden="true">NB</span>
      </a>

      <nav class="nav" aria-label={locale === 'en' ? 'Primary' : 'Principal'}>
        <ul>
          {
            navItems.map(({ key, label }) => (
              <li>
                <a
                  href={ROUTES[key][locale]}
                  aria-current={path.startsWith(ROUTES[key][locale]) ? 'page' : undefined}
                  data-astro-prefetch
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div
        class="chrome-end"
        role="group"
        aria-label={locale === 'en' ? 'Preferences' : 'Preferencias'}
      >
        <div class="lang-toggle">
          <a
            class={`lang ${locale === 'en' ? 'on' : ''}`}
            href={locale === 'en' ? path : (siblingPath ?? path)}
            aria-current={locale === 'en' ? 'page' : undefined}
            aria-disabled={locale === 'es' && toggleDisabled ? 'true' : undefined}
            data-lang="en"
          >
            EN
          </a>
          <span aria-hidden="true">·</span>
          <a
            class={`lang ${locale === 'es' ? 'on' : ''}`}
            href={locale === 'es' ? path : (siblingPath ?? path)}
            aria-current={locale === 'es' ? 'page' : undefined}
            aria-disabled={locale === 'en' && toggleDisabled ? 'true' : undefined}
            data-lang="es"
          >
            ES
          </a>
          {
            toggleDisabled && (
              <span class="only-note" data-testid="only-note">
                {locale === 'en' ? 'Only in English.' : 'Solo en español.'}
              </span>
            )
          }
        </div>

        <button
          type="button"
          id="theme-toggle"
          role="switch"
          aria-checked="false"
          aria-label={locale === 'en' ? 'Toggle dark mode' : 'Alternar modo oscuro'}
        >
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <p>
        <small>
          {locale === 'en' ? '© ' : '© '}Nicolas Bracigliano · {new Date().getFullYear()} ·
          <a href={ROUTES.colophon[locale]}>{locale === 'en' ? 'Colophon' : 'Colofón'}</a>
        </small>
      </p>
    </footer>

    <script>
      // Theme + language toggle, event-delegated so it survives <ClientRouter />
      // body swaps (the script itself is bundled once and persists; the bound
      // listener lives on `document`, not on per-page elements).
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

      type Theme = 'dia' | 'noche';

      const root = document.documentElement;

      // Initial sync: if theme-init.js applied a stored value, mirror it on
      // the toggle's aria-checked. Otherwise pick from system preference.
      function syncTheme(): void {
        const stored = (() => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        })();
        let theme: Theme;
        if (stored === 'dia' || stored === 'noche') {
          theme = stored;
        } else {
          theme = window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'noche' : 'dia';
        }
        root.dataset.theme = theme;
        const btn = document.getElementById('theme-toggle');
        btn?.setAttribute('aria-checked', String(theme === 'noche'));
      }
      syncTheme();

      // FOUC prevention across ClientRouter navigations.
      //
      // ClientRouter replaces the `<html>` element's attributes with the
      // incoming page's, which wipes our client-side `data-theme`. Without
      // intervention the page paints in light mode for one frame before
      // `astro:page-load` re-applies the user's theme — visible flash.
      //
      // `astro:before-swap` fires AFTER the new document has been parsed
      // but BEFORE its attributes are committed. Mutating the incoming
      // `<html>` here means the swap brings the correct theme in atomically.
      document.addEventListener('astro:before-swap', (event) => {
        const evt = event as TransitionBeforeSwapEvent;
        const current = root.dataset.theme;
        if (current === 'dia' || current === 'noche') {
          evt.newDocument.documentElement.dataset.theme = current;
        }
      });

      // Belt-and-braces: re-sync the toggle's aria-checked after each
      // navigation (the button is a fresh DOM node post-swap).
      document.addEventListener('astro:page-load', syncTheme);

      // One delegated click handler covers both toggles for the life of the tab.
      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;

        const themeBtn = target?.closest<HTMLButtonElement>('#theme-toggle');
        if (themeBtn) {
          const next: Theme = root.dataset.theme === 'noche' ? 'dia' : 'noche';
          root.dataset.theme = next;
          themeBtn.setAttribute('aria-checked', String(next === 'noche'));
          try {
            localStorage.setItem('theme', next);
          } catch {
            /* localStorage unavailable */
          }
          return;
        }

        const langLink = target?.closest<HTMLAnchorElement>('.lang-toggle a[data-lang]');
        if (langLink) {
          if (langLink.getAttribute('aria-disabled') === 'true') {
            event.preventDefault();
            return;
          }
          try {
            localStorage.setItem('lang', langLink.dataset['lang'] ?? 'en');
          } catch {
            /* localStorage unavailable */
          }
        }
      });
    </script>
  </body>
</html>
