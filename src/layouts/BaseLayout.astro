---
import '@styles/reset.css';
import '@styles/tokens.css';
import '@styles/base.css';
import '@styles/animations.css';
import { ClientRouter } from 'astro:transitions';
import { ROUTES, type Locale } from '@lib/routes';

export interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Current page path (e.g. "/en/notes/hello/") */
  path: string;
  /** Sibling path in the other locale, or null if there is no published translation */
  siblingPath: string | null;
  /** Optional override for OG image (absolute URL or path under site origin) */
  ogImage?: string;
}

const { title, description, locale, path, siblingPath, ogImage } = Astro.props;
const site = Astro.site?.toString() ?? 'https://nicolasbracigliano.com';
const origin = site.replace(/\/$/, '');

const enHref = locale === 'en' ? path : (siblingPath ?? path);
const esHref = locale === 'es' ? path : (siblingPath ?? path);

const toggleDisabled = siblingPath === null;

const navItems: Array<{ key: keyof typeof ROUTES; label: string }> =
  locale === 'en'
    ? [
        { key: 'home', label: 'home' },
        { key: 'notes', label: 'notes' },
        { key: 'works', label: 'works' },
        { key: 'about', label: 'about' },
        { key: 'colophon', label: 'colophon' },
      ]
    : [
        { key: 'home', label: 'inicio' },
        { key: 'notes', label: 'notas' },
        { key: 'works', label: 'obras' },
        { key: 'about', label: 'sobre' },
        { key: 'colophon', label: 'colofón' },
      ];

// Home needs exact match — every /en/* path startsWith /en/.
function isActive(key: keyof typeof ROUTES, currentPath: string): boolean {
  const target = ROUTES[key][locale];
  return key === 'home' ? currentPath === target : currentPath.startsWith(target);
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={`${origin}${path}`} />
    <link rel="alternate" hreflang="en" href={`${origin}${enHref}`} />
    <link rel="alternate" hreflang="es" href={`${origin}${esHref}`} />
    <link rel="alternate" hreflang="x-default" href={`${origin}${enHref}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={`${origin}${path}`} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_AR'} />
    {
      ogImage && (
        <meta
          property="og:image"
          content={ogImage.startsWith('http') ? ogImage : `${origin}${ogImage}`}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* External file so CSP can stay `script-src 'self'` with no hashes. */}
    <script is:inline src="/theme-init.js"></script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="chrome" transition:animate="none">
      <a
        href={ROUTES.home[locale]}
        class="mark"
        aria-label={locale === 'en' ? 'Home' : 'Inicio'}
        transition:name="mark"
      >
        <span class="mark-cube" aria-hidden="true">
          <span class="cube-face cube-face--front">NB</span>
          <span class="cube-face cube-face--back">NB</span>
        </span>
        <span class="mark-word" aria-hidden="true"
          ><span class="mark-given">Nicolás</span>&nbsp;<span class="mark-family">Bracigliano</span
          ></span
        >
      </a>

      <nav class="nav" aria-label={locale === 'en' ? 'Primary' : 'Principal'}>
        <ul>
          {
            navItems.map(({ key, label }) => (
              <li>
                <a
                  href={ROUTES[key][locale]}
                  aria-current={isActive(key, path) ? 'page' : undefined}
                  data-astro-prefetch
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div
        class="chrome-end"
        role="group"
        aria-label={locale === 'en' ? 'Preferences' : 'Preferencias'}
      >
        <div class="lang-toggle">
          <a
            class={`lang ${locale === 'en' ? 'on' : ''}`}
            href={locale === 'en' ? path : (siblingPath ?? path)}
            aria-current={locale === 'en' ? 'page' : undefined}
            aria-disabled={locale === 'es' && toggleDisabled ? 'true' : undefined}
            data-lang="en"
          >
            <span class="lang-chip">en</span>
          </a>
          <span aria-hidden="true">·</span>
          <a
            class={`lang ${locale === 'es' ? 'on' : ''}`}
            href={locale === 'es' ? path : (siblingPath ?? path)}
            aria-current={locale === 'es' ? 'page' : undefined}
            aria-disabled={locale === 'en' && toggleDisabled ? 'true' : undefined}
            data-lang="es"
          >
            <span class="lang-chip">es</span>
          </a>
          {
            toggleDisabled && (
              <span class="only-note" data-testid="only-note">
                {locale === 'en' ? 'Only in English.' : 'Solo en español.'}
              </span>
            )
          }
        </div>

        <button
          type="button"
          id="theme-toggle"
          role="switch"
          aria-checked="false"
          aria-label={locale === 'en' ? 'Toggle dark mode' : 'Alternar modo oscuro'}
        >
          <svg viewBox="0 0 22 22" width="18" height="18" aria-hidden="true">
            <defs>
              <mask id="moon-crescent">
                <rect width="22" height="22" fill="white"></rect>
                <circle class="moon-mask" cx="14" cy="9" r="4.5" fill="black"></circle>
              </mask>
            </defs>
            <g
              class="sun-rays"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              fill="none"
            >
              <line x1="11" y1="2" x2="11" y2="4"></line>
              <line x1="11" y1="18" x2="11" y2="20"></line>
              <line x1="2" y1="11" x2="4" y2="11"></line>
              <line x1="18" y1="11" x2="20" y2="11"></line>
              <line x1="4.5" y1="4.5" x2="6" y2="6"></line>
              <line x1="16" y1="16" x2="17.5" y2="17.5"></line>
              <line x1="4.5" y1="17.5" x2="6" y2="16"></line>
              <line x1="16" y1="6" x2="17.5" y2="4.5"></line>
            </g>
            <circle
              class="sun-disc"
              cx="11"
              cy="11"
              r="4.5"
              fill="currentColor"
              mask="url(#moon-crescent)"></circle>
          </svg>
          {/* Label content is set in base.css via ::before keyed on [data-theme] + [lang]. */}
          <span class="theme-toggle-label" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    {
      /* Sibling of .chrome (not a child) so position: fixed isn't trapped by
        the chrome's backdrop-filter containing block. Hidden on desktop via
        CSS; .chrome .nav is hidden on mobile in exchange. */
    }
    <nav class="foot-rail" aria-label={locale === 'en' ? 'Primary' : 'Principal'}>
      <ul>
        {
          navItems.map(({ key, label }) => (
            <li>
              <a
                href={ROUTES[key][locale]}
                aria-current={isActive(key, path) ? 'page' : undefined}
                data-astro-prefetch
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <p>
        <small>
          {locale === 'en' ? '© ' : '© '}Nicolas Bracigliano · {new Date().getFullYear()} ·
          <a href={ROUTES.colophon[locale]}>{locale === 'en' ? 'Colophon' : 'Colofón'}</a>
        </small>
      </p>
    </footer>

    <script>
      // Event-delegated handlers — bundled once, survive ClientRouter body swaps.
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

      type Theme = 'dia' | 'noche';

      const root = document.documentElement;

      function readStoredTheme(): Theme | null {
        try {
          const stored = localStorage.getItem('theme');
          return stored === 'dia' || stored === 'noche' ? stored : null;
        } catch {
          return null;
        }
      }

      function resolveTheme(): Theme {
        return (
          readStoredTheme() ??
          (window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'noche' : 'dia')
        );
      }

      function applyTheme(theme: Theme): void {
        root.dataset.theme = theme;
        const btn = document.getElementById('theme-toggle');
        btn?.setAttribute('aria-checked', String(theme === 'noche'));
      }

      function syncTheme(): void {
        applyTheme(resolveTheme());
      }

      document.addEventListener('astro:page-load', syncTheme);

      const HIDE_AT_SCROLL_PX = 120;
      const ALWAYS_SHOW_BELOW_PX = 60;
      const DY_DEBOUNCE_PX = 5;

      let lastScrollY = window.scrollY;
      let scrollTicking = false;
      function updateFootRailVisibility(): void {
        const rail = document.querySelector<HTMLElement>('.foot-rail');
        if (!rail) {
          scrollTicking = false;
          return;
        }
        const y = window.scrollY;
        const dy = y - lastScrollY;
        if (y > HIDE_AT_SCROLL_PX && dy > DY_DEBOUNCE_PX) {
          rail.classList.add('is-hidden');
        } else if (dy < -DY_DEBOUNCE_PX || y <= ALWAYS_SHOW_BELOW_PX) {
          rail.classList.remove('is-hidden');
        }
        lastScrollY = y;
        scrollTicking = false;
      }
      window.addEventListener(
        'scroll',
        () => {
          if (!scrollTicking) {
            requestAnimationFrame(updateFootRailVisibility);
            scrollTicking = true;
          }
        },
        { passive: true },
      );
      document.addEventListener('astro:page-load', () => {
        lastScrollY = window.scrollY;
        document.querySelector<HTMLElement>('.foot-rail')?.classList.remove('is-hidden');
      });

      // Neutralise the cube's hover rotation during view-transition
      // snapshots — 3D perspective interpolates oddly otherwise.
      document.addEventListener('astro:before-swap', () => {
        document.querySelector('.mark')?.setAttribute('data-vt-active', '');
      });
      document.addEventListener('astro:after-swap', () => {
        document.querySelector('.mark')?.removeAttribute('data-vt-active');
      });

      // ClientRouter replaces <html> attributes on swap; without this,
      // data-theme is wiped for one frame and the page flashes light
      // before astro:page-load re-applies the user's theme.
      document.addEventListener('astro:before-swap', (event) => {
        const evt = event as TransitionBeforeSwapEvent;
        const current = root.dataset.theme;
        if (current === 'dia' || current === 'noche') {
          evt.newDocument.documentElement.dataset.theme = current;
        }
      });

      window.addEventListener('storage', (event) => {
        if (event.key !== 'theme') return;
        if (event.newValue === 'dia' || event.newValue === 'noche') {
          applyTheme(event.newValue);
        } else if (event.newValue === null) {
          applyTheme(resolveTheme());
        }
      });

      // Retire-on-match: when the OS theme catches up to the user's
      // override, drop the override so future OS toggles are followed
      // automatically. Override that disagrees with the OS is kept.
      const mql = window.matchMedia?.('(prefers-color-scheme: dark)');
      mql?.addEventListener('change', (event) => {
        const osTheme: Theme = event.matches ? 'noche' : 'dia';
        const stored = readStoredTheme();
        if (stored === null) {
          applyTheme(osTheme);
        } else if (stored === osTheme) {
          try {
            localStorage.removeItem('theme');
          } catch {
            /* localStorage unavailable */
          }
          applyTheme(osTheme);
        }
      });

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;

        const themeBtn = target?.closest<HTMLButtonElement>('#theme-toggle');
        if (themeBtn) {
          const next: Theme = root.dataset.theme === 'noche' ? 'dia' : 'noche';
          applyTheme(next);
          try {
            localStorage.setItem('theme', next);
          } catch {
            /* localStorage unavailable */
          }
          return;
        }

        const langLink = target?.closest<HTMLAnchorElement>('.lang-toggle a[data-lang]');
        if (langLink) {
          if (langLink.getAttribute('aria-disabled') === 'true') {
            event.preventDefault();
            return;
          }
          try {
            localStorage.setItem('lang', langLink.dataset['lang'] ?? 'en');
          } catch {
            /* localStorage unavailable */
          }
        }
      });
    </script>
  </body>
</html>
