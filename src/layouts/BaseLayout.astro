---
import '@styles/fonts.css';
import '@styles/reset.css';
import '@styles/tokens.css';
import '@styles/base.css';
import '@styles/animations.css';
import { ClientRouter } from 'astro:transitions';
import { ROUTES, buildHreflangAlternates, type Locale } from '@lib/routes';
import { getNavItems } from '@lib/chrome-nav';
import CommandPalette from '@components/CommandPalette.astro';

export interface Props {
  title: string;
  /** When the source is `entry.data.lede` (which is `string | undefined`),
   *  callers must conditionally spread: `{...(lede && { description: lede })}`.
   *  Keeps `exactOptionalPropertyTypes` honest — present vs absent stays
   *  distinct from present-with-undefined. */
  description?: string;
  locale: Locale;
  /** Current page path (e.g. "/en/notes/hello/") */
  path: string;
  /** Sibling path in the other locale, or null if there is no published translation */
  siblingPath: string | null;
  /** Optional override for OG image (absolute URL or path under site origin) */
  ogImage?: string;
  /** Emit `<meta name="robots" content="noindex">` and skip the
   *  canonical / og:url emission. Set on the 404 fallback and any
   *  other route that shouldn't be indexed (draft pages, etc.).
   *  Default `false`. */
  noindex?: boolean;
}

const { title, description, locale, path, siblingPath, ogImage, noindex = false } = Astro.props;
const site = Astro.site?.toString() ?? 'https://nicolasbracigliano.com';
const origin = site.replace(/\/$/, '');

const hreflangs = buildHreflangAlternates(origin, { locale, path }, siblingPath);

const toggleDisabled = siblingPath === null;

const navItems = getNavItems(locale);

// Home needs exact match — every /en/* path startsWith /en/.
function isActive(key: keyof typeof ROUTES, currentPath: string): boolean {
  const target = ROUTES[key][locale];
  return key === 'home' ? currentPath === target : currentPath.startsWith(target);
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={`${origin}${path}`} />}
    {
      /* Hreflang alternates are paired with the canonical: both
         describe "this URL's role in the indexed graph." Noindex
         pages aren't in that graph, so drop alternates too. */
      !noindex && hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={`${origin}${path}`} />}
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_AR'} />
    {
      ogImage && (
        <meta
          property="og:image"
          content={ogImage.startsWith('http') ? ogImage : `${origin}${ogImage}`}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="apple-mobile-web-app-title" content="Nicolas Bracigliano" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
    <link rel="manifest" href="/site.webmanifest" />

    {
      /* Preload the self-hosted woff2 so the swap from the fallback stack
        happens early (less FOUT on the type-forward hero). Same-origin,
        but font fetches are always CORS-anonymous, so `crossorigin` is
        required for the preload to match the actual request. */
    }
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* External file so CSP can stay `script-src 'self'` with no hashes. */}
    <script is:inline src="/theme-init.js"></script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="chrome" transition:animate="none">
      {
        /* No `transition:name="mark"` on purpose — the 3D cube (perspective +
          preserve-3d + backface-visibility) doesn't snapshot reliably for
          the View Transitions cross-fade, so we keep the mark static across
          navigations (the chrome's `transition:animate="none"` already does
          this for everything else inside the header). */
      }
      <a href={ROUTES.home[locale]} class="mark" aria-label={locale === 'en' ? 'Home' : 'Inicio'}>
        <span class="mark-cube" aria-hidden="true">
          <span class="cube-face cube-face--front">NB</span>
          <span class="cube-face cube-face--back">NB</span>
        </span>
        <span class="mark-word" aria-hidden="true"
          ><span class="mark-given">Nicolás</span>&nbsp;<span class="mark-family">Bracigliano</span
          ></span
        >
      </a>

      <nav class="nav" aria-label={locale === 'en' ? 'Primary' : 'Principal'}>
        <ul>
          {
            navItems.map(({ key, label }) => (
              <li>
                <a
                  href={ROUTES[key][locale]}
                  aria-current={isActive(key, path) ? 'page' : undefined}
                  data-astro-prefetch
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div
        class="chrome-end"
        role="group"
        aria-label={locale === 'en' ? 'Preferences' : 'Preferencias'}
      >
        <button
          type="button"
          class="cmdk-trigger"
          data-cmdk-open
          aria-label={locale === 'en' ? 'Open search (Command K)' : 'Abrir búsqueda (Command K)'}
        >
          <svg
            viewBox="0 0 16 16"
            width="14"
            height="14"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <circle cx="7" cy="7" r="4.5"></circle>
            <line x1="10.5" y1="10.5" x2="14" y2="14" stroke-linecap="round"></line>
          </svg>
          <span class="cmdk-trigger-label">{locale === 'en' ? 'jump to…' : 'ir a…'}</span>
          <span class="cmdk-trigger-key" aria-hidden="true"><kbd>⌘</kbd><kbd>K</kbd></span>
        </button>

        <div class="lang-toggle">
          <a
            class={`lang ${locale === 'en' ? 'on' : ''}`}
            href={locale === 'en' ? path : (siblingPath ?? path)}
            aria-current={locale === 'en' ? 'page' : undefined}
            aria-disabled={locale === 'es' && toggleDisabled ? 'true' : undefined}
            data-lang="en"
          >
            <span class="lang-chip">en</span>
          </a>
          <span aria-hidden="true">·</span>
          <a
            class={`lang ${locale === 'es' ? 'on' : ''}`}
            href={locale === 'es' ? path : (siblingPath ?? path)}
            aria-current={locale === 'es' ? 'page' : undefined}
            aria-disabled={locale === 'en' && toggleDisabled ? 'true' : undefined}
            data-lang="es"
          >
            <span class="lang-chip">es</span>
          </a>
          {
            toggleDisabled && (
              <span class="only-note" data-testid="only-note">
                {locale === 'en' ? 'Only in English.' : 'Solo en español.'}
              </span>
            )
          }
        </div>

        <button
          type="button"
          id="theme-toggle"
          role="switch"
          aria-checked="false"
          aria-label={locale === 'en' ? 'Toggle dark mode' : 'Alternar modo oscuro'}
        >
          <svg viewBox="0 0 22 22" width="18" height="18" aria-hidden="true">
            <defs>
              <mask id="moon-crescent">
                <rect width="22" height="22" fill="white"></rect>
                <circle class="moon-mask" cx="14" cy="9" r="4.5" fill="black"></circle>
              </mask>
            </defs>
            <g
              class="sun-rays"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              fill="none"
            >
              <line x1="11" y1="2" x2="11" y2="4"></line>
              <line x1="11" y1="18" x2="11" y2="20"></line>
              <line x1="2" y1="11" x2="4" y2="11"></line>
              <line x1="18" y1="11" x2="20" y2="11"></line>
              <line x1="4.5" y1="4.5" x2="6" y2="6"></line>
              <line x1="16" y1="16" x2="17.5" y2="17.5"></line>
              <line x1="4.5" y1="17.5" x2="6" y2="16"></line>
              <line x1="16" y1="6" x2="17.5" y2="4.5"></line>
            </g>
            <circle
              class="sun-disc"
              cx="11"
              cy="11"
              r="4.5"
              fill="currentColor"
              mask="url(#moon-crescent)"></circle>
          </svg>
          {/* Label content is set in base.css via ::before keyed on [data-theme] + [lang]. */}
          <span class="theme-toggle-label" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    {
      /* Sibling of .chrome (not a child) so position: fixed isn't trapped by
        the chrome's backdrop-filter containing block. Hidden on desktop via
        CSS; .chrome .nav is hidden on mobile in exchange. Distinct aria-label
        from the top nav so html-validate's unique-landmark check passes —
        both navs ship in the source HTML even though only one is visible
        per viewport. */
    }
    <nav class="foot-rail" aria-label={locale === 'en' ? 'Primary (mobile)' : 'Principal (móvil)'}>
      <ul>
        {
          navItems.map(({ key, label }) => (
            <li>
              <a
                href={ROUTES[key][locale]}
                aria-current={isActive(key, path) ? 'page' : undefined}
                data-astro-prefetch
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <p>
        <small>
          {locale === 'en' ? '© ' : '© '}Nicolas Bracigliano · {new Date().getFullYear()} ·
          <a href={ROUTES.colophon[locale]}>{locale === 'en' ? 'Colophon' : 'Colofón'}</a>
        </small>
      </p>
    </footer>

    <CommandPalette locale={locale} />

    <script>
      import '../scripts/chrome';
    </script>
  </body>
</html>
