---
import BaseLayout from './BaseLayout.astro';
import NoteEntry from '@components/NoteEntry.astro';
import type { CollectionEntry } from 'astro:content';
import { ROUTES, type Locale } from '@lib/routes';
import { ogImageUrlFor } from '@lib/i18n';

export interface Props {
  entry: CollectionEntry<'notes'>;
  path: string;
  siblingPath: string | null;
}

const { entry, path, siblingPath } = Astro.props;
const { title, lede, lang } = entry.data;
const locale = lang as Locale;
const indexHref = ROUTES.notes[locale];
const indexLabel = locale === 'es' ? '↩ todas las notas' : '↩ all notes';
const ogImage = ogImageUrlFor(entry);
---

<BaseLayout
  title={title}
  locale={locale}
  path={path}
  siblingPath={siblingPath}
  ogImage={ogImage}
  {...lede && { description: lede }}
>
  <section class="notes wrap notes--single">
    <ol class="notes-list">
      <NoteEntry entry={entry} locale={locale} isFirst={true} isStandalone={true}>
        <slot />
      </NoteEntry>
    </ol>

    <footer class="notes-foot">
      <a class="back-link" href={indexHref} data-astro-prefetch>{indexLabel}</a>
    </footer>
  </section>
</BaseLayout>
