---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Masthead from '@components/Masthead.astro';
import Bench from '@components/Bench.astro';
import LatestEntries from '@components/LatestEntries.astro';
import FieldNotesSidebar from '@components/FieldNotesSidebar.astro';
import Coffee from '@components/Coffee.astro';
import Mate from '@components/Mate.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';
import { assertNowEntry, benchItemsFrom } from '@lib/now-items';
import { buildLatest } from '@lib/latest-entries';
import { VERSION } from '@lib/version';

const entry = await getEntry('pages', 'es/home');
if (!entry) throw new Error('Missing pages/es/home');
const sibling = await getSibling(entry);
const { title, lede } = entry.data;

// "En el banco ahora" se deriva de los ítems de /now que llevan `teaser`
// — now.md es la única fuente para la grilla del banco y el tour completo
// de /ahora (reemplaza el viejo array `bench:` de home.md, que se había
// desincronizado). Ver ADR 0014.
const nowEntry = await getEntry('pages', 'es/now');
if (!nowEntry) throw new Error('Missing pages/es/now');
assertNowEntry(nowEntry);
const bench = benchItemsFrom(nowEntry.data.items);

// Latest across notes + works + pieces, newest first. buildLatest keys on
// every feed kind, so dropping a collection here is a compile error.
const [notes, works, pieces] = await Promise.all([
  getCollection('notes', (e) => e.data.lang === 'es' && e.data.status === 'published'),
  getCollection('works', (e) => e.data.lang === 'es' && e.data.status === 'published'),
  getCollection('pieces', (e) => e.data.lang === 'es' && e.data.status === 'published'),
]);
const latest = buildLatest({ note: notes, work: works, piece: pieces });

const elsewhere = [
  { label: 'github', href: 'https://github.com/nicolas-bracigliano' },
  { label: 'maker world', href: 'https://makerworld.com/en/@NicoBrachi' },
  { label: 'rss.xml', href: '/rss-en.xml', suffix: '(en)' },
  { label: 'rss.xml', href: '/rss-es.xml', suffix: '(es)' },
];

const reading = [{ title: 'Nexus', author: 'Yuval Noah Harari' }];
---

<BaseLayout
  title={title}
  locale="es"
  path={ROUTES.home.es}
  siblingPath={sibling ? entryRouteFor(sibling) : null}
  {...lede && { description: lede }}
>
  <article class="home">
    <Masthead portraitCaption="">
      <Fragment slot="eyebrow">
        Nicolás&nbsp;Bracigliano
        <span class="sep">·</span>
        <span class="dot mate" aria-hidden="true"></span>
        Melbourne,&nbsp;AU
        <span class="sep">·</span>
        <span class="now-time" data-now-melbourne>—:—</span>
      </Fragment>

      <h1 slot="h1">
        Hago <em>cosas</em>
        <br />
        frente a la pantalla,
        <br />
        <span class="indent">cosas</span> útiles
        <br />
        en casa,
        <br />
        <span class="indent2">y <Coffee label="un long black" /></span>
        <br />
        cada mañana.
      </h1>

      <Fragment slot="bio">
        Ingeniero de software senior, programando desde 2006. Fuera de la pantalla: guitarra,
        huerta, pileta, gimnasio, impresión 3D. Argentino, así que siempre hay <Mate /> en el escritorio.
        Audiolibro en una oreja, tijera de podar en la otra. Esto es el <em>colofón</em>: donde
        viven el trabajo, los borradores y los intentos.
      </Fragment>

      <Fragment slot="meta">
        <span>en proceso, en público</span>
        <span class="sep">·</span>
        <span>v.{VERSION}</span>
      </Fragment>
    </Masthead>

    <Bench items={bench} locale="es" />

    {
      latest.length > 0 && (
        <LatestEntries
          items={latest}
          eyebrow="Últimas entradas"
          descriptorLead="dos de cada"
          allLinksByKind={{
            work: { label: 'todas las obras →', href: ROUTES.works.es },
            piece: { label: 'todos los ensayos →', href: ROUTES.pieces.es },
            note: { label: 'todas las notas →', href: ROUTES.notes.es },
          }}
          locale="es"
          kindLabels={{ note: 'nota', work: 'obra', piece: 'ensayo' }}
        />
      )
    }

    <FieldNotesSidebar
      elsewhereLabel="En otros lados"
      readingLabel="Leyendo ahora"
      cupLabel="En la taza"
      elsewhere={elsewhere}
      reading={reading}
    >
      <Fragment slot="cup">
        <p class="cup">
          <Coffee />
          &nbsp;Brimstone, CommonFolks —<span class="muted">blend · Uganda, Kenia.</span>
        </p>
        <p class="cup">
          <Mate />
          &nbsp;La Merced, Monte —<span class="muted">amargo, siempre.</span>
        </p>
      </Fragment>
    </FieldNotesSidebar>
  </article>

  <script>
    const fmt = new Intl.DateTimeFormat('en-AU', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Australia/Melbourne',
    });
    function paintNow(): boolean {
      const el = document.querySelector<HTMLElement>('[data-now-melbourne]');
      if (!el) return false;
      el.textContent = fmt.format(new Date());
      return true;
    }
    function tick(): void {
      if (paintNow()) setTimeout(tick, 60_000);
    }

    // Bench vignettes animate once when the card scrolls 20% into view
    // (DS §15 — no looping vignettes). One observer per page-load;
    // unobserve after first hit so scroll-back doesn't re-trigger.
    function armBenchObserver(): void {
      const cards = document.querySelectorAll<HTMLElement>('.bench-card');
      if (cards.length === 0) return;
      if (!('IntersectionObserver' in window)) {
        cards.forEach((c) => c.classList.add('in-view'));
        return;
      }
      const obs = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 },
      );
      cards.forEach((c) => obs.observe(c));
    }

    document.addEventListener('astro:page-load', () => {
      armBenchObserver();
      if (!paintNow()) return;
      setTimeout(tick, (60 - new Date().getSeconds()) * 1000);
    });
  </script>
</BaseLayout>
