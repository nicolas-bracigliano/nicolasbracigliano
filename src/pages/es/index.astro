---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Masthead from '@components/Masthead.astro';
import BenchCard from '@components/BenchCard.astro';
import LatestEntries, { type LatestItem } from '@components/LatestEntries.astro';
import FieldNotesSidebar from '@components/FieldNotesSidebar.astro';
import Coffee from '@components/Coffee.astro';
import Mate from '@components/Mate.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';

const entry = await getEntry('pages', 'es/home');
if (!entry) throw new Error('Missing pages/es/home');
const sibling = await getSibling(entry);
const { title, lede } = entry.data;

const [notes, works] = await Promise.all([
  getCollection('notes', (e) => e.data.lang === 'es' && e.data.status === 'published'),
  getCollection('works', (e) => e.data.lang === 'es' && e.data.status === 'published'),
]);
const latest: LatestItem[] = [
  ...notes.map((e) => ({ entry: e, kind: 'note' as const })),
  ...works.map((e) => ({ entry: e, kind: 'work' as const })),
]
  .sort((a, b) => +b.entry.data.date - +a.entry.data.date)
  .slice(0, 4);

// "viernes, 22 de mayo" — lowercase, matches prototype's bench header.
const benchDate = new Intl.DateTimeFormat('es-AR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Australia/Melbourne',
})
  .format(new Date())
  .toLowerCase();

const bench = [
  {
    kind: 'code' as const,
    tag: '01 · código',
    title: 'Un pequeño generador de sitios estáticos',
    line: 'Markdown entra, Lighthouse 100 sale. Día tres reescribiéndolo en Rust, sobre todo para descubrir lo que no sé.',
  },
  {
    kind: 'guitar' as const,
    tag: '02 · guitarra',
    title: 'Aprendiendo Milonga del Ángel',
    line: 'Piazzolla. La digitación de la mano derecha es un acertijo. Loopeo los compases 9–16 a mitad de velocidad.',
    guitarLabel: 'A m | Milonga del Ángel · compás 9',
  },
  {
    kind: 'garden' as const,
    tag: '03 · huerta',
    title: 'Tomates contra el octubre melburnés',
    line: 'Black Russian, San Marzano, un cajoncito de albahaca. Los polinizadores llegaron dos semanas antes.',
    seedlingTag: 'tomate',
  },
  {
    kind: 'print' as const,
    tag: '04 · 3d',
    title: 'Una bandeja modular para juntar cosas',
    line: 'Imanes en las esquinas; el hueco para el tamper de espresso por fin entra. Cinco iteraciones después.',
  },
];

const elsewhere = [
  { label: 'github / nicolas', href: 'https://github.com/' },
  { label: 'printables / nicolas', href: 'https://www.printables.com/' },
  { label: 'mastodon @ nicolas', href: 'https://mastodon.social/' },
  { label: 'rss.xml', href: '/rss-en.xml', suffix: '(en)' },
  { label: 'rss.xml', href: '/rss-es.xml', suffix: '(es)' },
];

const reading = [
  { title: 'The Mom Test', author: 'Rob Fitzpatrick' },
  { title: 'El jardín de senderos que se bifurcan', author: 'Jorge Luis Borges' },
  { title: 'A Philosophy of Software Design', author: 'John Ousterhout' },
];
---

<BaseLayout
  title={title}
  locale="es"
  path={ROUTES.home.es}
  siblingPath={sibling ? entryRouteFor(sibling) : null}
  {...lede && { description: lede }}
>
  <article class="home">
    <Masthead portraitCaption="retrato · pendiente">
      <Fragment slot="eyebrow">
        Nicolás&nbsp;Bracigliano
        <span class="sep">·</span>
        <span class="dot mate" aria-hidden="true"></span>
        Melbourne,&nbsp;AU
        <span class="sep">·</span>
        <span class="now-time" data-now-melbourne>—:—</span>
      </Fragment>

      <h1 slot="h1">
        Hago <em>cosas</em>
        <br />
        en internet,
        <br />
        <span class="indent">cosas</span>
        <br />
        útiles en casa,
        <br />
        <span class="indent2">y <Coffee label="un café largo" /></span>
        <br />
        cada mañana.
      </h1>

      <Fragment slot="bio">
        Ingeniero de software senior, veinte años. Fuera de la pantalla: guitarra, diseño 3D,
        huerta, pileta, gimnasio. Argentino, así que siempre hay <Mate /> en la taza. Audiolibro en una
        oreja, tijera de podar en la otra. Esto es el <em>colofón</em> — un lugar para guardar el trabajo,
        los borradores, y los recibos.
      </Fragment>

      <Fragment slot="meta">
        <span>en proceso, en público</span>
        <span class="sep">·</span>
        <span>v.1.0 · hecho a mano</span>
      </Fragment>
    </Masthead>

    <section class="bench" aria-labelledby="bench-h">
      <header class="bench-head">
        <span class="eyebrow" id="bench-h">En el banco ahora</span>
        <span class="bench-date">{benchDate}</span>
      </header>
      <ul class="bench-grid">
        {
          bench.map((b) => (
            <li>
              <BenchCard {...b} />
            </li>
          ))
        }
      </ul>
    </section>

    {
      latest.length > 0 && (
        <LatestEntries
          items={latest}
          eyebrow="Últimas entradas"
          allEntriesLabel="todas las entradas →"
          allEntriesHref={ROUTES.notes.es}
          kindLabels={{ note: 'nota', work: 'obra', essay: 'ensayo' }}
        />
      )
    }

    <FieldNotesSidebar
      elsewhereLabel="En otros lados"
      readingLabel="Leyendo ahora"
      cupLabel="En la taza"
      elsewhere={elsewhere}
      reading={reading}
    >
      <Fragment slot="cup">
        <p class="cup">
          <Coffee />
          &nbsp;Padre Coffee, Brunswick — <span class="muted">origen único, Etiopía.</span>
        </p>
        <p class="cup">
          <Mate />
          &nbsp;Cruz de Malta — <span class="muted">amargo, siempre.</span>
        </p>
      </Fragment>
    </FieldNotesSidebar>
  </article>

  <script>
    const fmt = new Intl.DateTimeFormat('en-AU', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Australia/Melbourne',
    });
    function paintNow(): boolean {
      const el = document.querySelector<HTMLElement>('[data-now-melbourne]');
      if (!el) return false;
      el.textContent = fmt.format(new Date());
      return true;
    }
    function tick(): void {
      if (paintNow()) setTimeout(tick, 60_000);
    }

    // Bench vignettes animate once when the card scrolls 20% into view
    // (DS §15 — no looping vignettes). One observer per page-load;
    // unobserve after first hit so scroll-back doesn't re-trigger.
    function armBenchObserver(): void {
      const cards = document.querySelectorAll<HTMLElement>('.bench-card');
      if (cards.length === 0) return;
      if (!('IntersectionObserver' in window)) {
        cards.forEach((c) => c.classList.add('in-view'));
        return;
      }
      const obs = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 },
      );
      cards.forEach((c) => obs.observe(c));
    }

    document.addEventListener('astro:page-load', () => {
      armBenchObserver();
      if (!paintNow()) return;
      setTimeout(tick, (60 - new Date().getSeconds()) * 1000);
    });
  </script>
</BaseLayout>
