---
import { getEntry, render } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';

const entry = await getEntry('pages', 'es/colophon');
if (!entry) throw new Error('Missing pages/es/colophon');
const sibling = await getSibling(entry);
const { Content } = await render(entry);
---

<PageLayout
  entry={entry}
  path={ROUTES.colophon.es}
  siblingPath={sibling ? entryRouteFor(sibling) : null}
>
  <Content />
</PageLayout>
