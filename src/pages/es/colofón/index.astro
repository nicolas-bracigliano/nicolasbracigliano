---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ColophonMasthead from '@components/ColophonMasthead.astro';
import ColophonSection from '@components/ColophonSection.astro';
import ColophonRow from '@components/ColophonRow.astro';
import AsciiSignature from '@components/AsciiSignature.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';

const entry = await getEntry('pages', 'es/colophon');
if (!entry) throw new Error('Missing pages/es/colophon');
const sibling = await getSibling(entry);
const { title, lede } = entry.data;

const path = ROUTES.colophon.es;
const siblingPath = sibling ? entryRouteFor(sibling) : null;
---

<BaseLayout
  title={title}
  locale="es"
  path={path}
  siblingPath={siblingPath}
  {...lede && { description: lede }}
>
  <section class="colofon wrap">
    <ColophonMasthead locale="es" />

    <ColophonSection tag="01" title="Hecho con">
      <ColophonRow dt="lenguaje">
        html · css · typescript (sin framework en la página)
      </ColophonRow>
      <ColophonRow dt="generador">
        <a href="/es/obras/este-sitio/">astro 7</a> · salida estática · casi sin JS
      </ColophonRow>
      <ColophonRow dt="probado">playwright en chromium · axe-core a11y · lighthouse ci</ColophonRow>
      <ColophonRow dt="búsqueda">paleta ⌘K · índice de navegación, sin texto completo</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="02" title="Compuesto en">
      <ColophonRow dt="titular">
        <span class="serif">Newsreader</span> · variable, 400–600
      </ColophonRow>
      <ColophonRow dt="cuerpo">
        <span class="mono-display">JetBrains Mono</span> · variable, 100–700
      </ColophonRow>
      <ColophonRow dt="alternativas">iowan old style, georgia · ui-monospace, menlo</ColophonRow>
      <ColophonRow dt="a11y"> mín. 15 px en cuerpo · interlínea 1.55 · contraste AA+ </ColophonRow>
    </ColophonSection>

    <ColophonSection tag="03" title="Alojado en">
      <ColophonRow dt="sirve">cloudflare workers · static assets</ColophonRow>
      <ColophonRow dt="recursos">fuentes propias · sin scripts de terceros</ColophonRow>
      <ColophonRow dt="privacidad">sin cookies · sin analítica · sin beacon</ColophonRow>
      <ColophonRow dt="dns">cloudflare · DNSSEC + HSTS preload</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="04" title="Flujo">
      <ColophonRow dt="escribir">markdown en /src/content, tipado con Zod</ColophonRow>
      <ColophonRow dt="vista previa">astro dev · recarga en vivo al guardar</ColophonRow>
      <ColophonRow dt="publicar">git push → github actions → wrangler deploy</ColophonRow>
      <ColophonRow dt="borrador">un estado en el frontmatter, fuera del build</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="05" title="Principios" accent>
      <ColophonRow dt="hecho a mano"> cada página muestra el oficio. nada se replica. </ColophonRow>
      <ColophonRow dt="un hacedor, muchos oficios">
        código, guitarra, huerta, 3D: caras de una sola persona.
      </ColophonRow>
      <ColophonRow dt="las herramientas se ven">esta página existe por esa razón.</ColophonRow>
      <ColophonRow dt="en público, en proceso">
        borradores bienvenidos. semillas cuidadas a la vista.
      </ColophonRow>
      <ColophonRow dt="curiosidad antes que conclusión">
        los títulos pueden ser preguntas.
      </ColophonRow>
      <ColophonRow dt="perf, a11y, seguridad">como estética, no como casilleros.</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="06" title="El escritorio">
      <ColophonRow dt="combustible">mate todo el día · un long black a la mañana</ColophonRow>
    </ColophonSection>

    <AsciiSignature locale="es" />
  </section>
</BaseLayout>
