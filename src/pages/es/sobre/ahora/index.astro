---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import NowMasthead from '@components/NowMasthead.astro';
import NowItem from '@components/NowItem.astro';
import type { NowItemKind } from '@components/NowItem.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';

const entry = await getEntry('pages', 'es/now');
if (!entry) throw new Error('Missing pages/es/now');
const sibling = await getSibling(entry);
const { title, lede } = entry.data;

const path = ROUTES.now.es;
const siblingPath = sibling ? entryRouteFor(sibling) : null;

// Seis ítems del momento, orden fijo. Cada uno es una actualización
// real de la mesa — qué está abierto, qué se tocó última vez, qué
// viene. Si el contenido cambia con menos de una semana de
// frecuencia, la fecha del masthead ("última actualización esta
// semana") miente; actualizar ambas cosas juntas.
const items: Array<{
  kind: NowItemKind;
  where: string;
  title: string;
  prose: string;
  detail: Array<{ dt: string; dd: string }>;
}> = [
  {
    kind: 'code',
    where: 'sobre la mesa · código',
    title: 'Reescribiendo ssg en Rust',
    prose:
      'El generador de sitios que construye esta página era un script de Node. Sigue funcionando, pero quería saber qué cosas no sabía — así que lo estoy portando. El plan: parser de markdown, frontmatter, un hasher de assets, un constructor de feeds. Día tres. El compilador me enseña más que el runtime alguna vez.',
    detail: [
      { dt: 'progreso', dd: 'parser ✓ · feed ✓ · pipeline de assets (wip)' },
      { dt: 'líneas', dd: '~640 / meta ~800' },
      { dt: 'aprendí', dd: 'Result<T, E> como herramienta de diseño' },
    ],
  },
  {
    kind: 'guitar',
    where: 'entre las manos · guitarra',
    title: 'Compases 9–16 de la Milonga del Ángel',
    prose:
      'Piazzolla. Vengo loopeando los mismos ocho compases a media velocidad hace tres semanas. La mano derecha es el rompecabezas — la alternancia i/m tiene que esquivar la cuerda m con el apoyando. Bien lento se siente cómo la nota grave arrastra a la melodía atrás.',
    detail: [
      { dt: 'meta', dd: 'compás 9–16 limpio a 88 bpm' },
      { dt: 'hoy', dd: '62 bpm, 30 min loopeado' },
      { dt: 'mañana', dd: '68 bpm, con dinámicas' },
    ],
  },
  {
    kind: 'garden',
    where: 'en la huerta · jardín',
    title: 'Rotación de primavera, plantada',
    prose:
      'Black Russian, San Marzano, un plantín de albahaca genovesa, manzanilla, dos tipos de ají. Las abejas nativas aparecieron dos semanas antes que el año pasado. La borraja está haciendo lo suyo.',
    detail: [
      { dt: 'cantero', dd: '1.4 × 3 m elevado' },
      { dt: 'compañeras', dd: 'tom + albahaca + manzanilla' },
      { dt: 'esperando', dd: 'primer fruto en ~5 semanas' },
    ],
  },
  {
    kind: 'print',
    where: 'en el slicer · 3D',
    title: 'Bandeja para guardar todo, rev 5',
    prose:
      'Cinco iteraciones para que entre el tamper del espresso. Imanes en las esquinas; la ranura finalmente encaja sin juego. Los fillets son demasiado agresivos — los suavizo en la rev 6.',
    detail: [
      { dt: 'material', dd: 'PETG, reciclado' },
      { dt: 'capa', dd: '0.16 mm · 4 paredes' },
      { dt: 'próximo', dd: 'rev 6: fillets más suaves' },
    ],
  },
  {
    kind: 'coffee',
    where: 'en la taza · café + mate',
    title: 'Padre Etiopía, y Cruz de Malta',
    prose:
      'A la mañana: 20 g entran, 38 g salen, 28 segundos. Padre Coffee, Brunswick — un Etiopía lavado, brillante y floral. Cerca de las 10:30, mate. Cruz de Malta, amargo, con agua caliente de la pava en la misma hornalla que todo lo demás.',
    detail: [
      { dt: 'granos', dd: 'Padre Coffee, Etiopía lavado' },
      { dt: 'mate', dd: 'Cruz de Malta · amargo' },
      { dt: 'ritual', dd: 'todas las mañanas · ~7:20' },
    ],
  },
  {
    kind: 'read',
    where: 'en los oídos · leyendo y escuchando',
    title: 'Borges en un oído, Ousterhout en el otro',
    prose:
      'Leyendo A Philosophy of Software Design despacio, sobre todo en el tranvía. Borges (El jardín de senderos que se bifurcan) en audiolibro mientras podo. The Mom Test los sábados a la tarde, al sol.',
    detail: [
      { dt: 'papel', dd: 'Borges · El jardín…' },
      { dt: 'audio', dd: 'Ousterhout · A Philosophy of Software Design' },
      { dt: 'podcast', dd: 'Ezra Klein, a veces' },
    ],
  },
];
---

<BaseLayout
  title={title}
  locale="es"
  path={path}
  siblingPath={siblingPath}
  {...lede && { description: lede }}
>
  <section class="now wrap">
    <NowMasthead locale="es" />

    <ol class="now-list">
      {
        items.map((item, i) => (
          <NowItem
            index={i + 1}
            kind={item.kind}
            where={item.where}
            title={item.title}
            prose={item.prose}
            detail={item.detail}
          />
        ))
      }
    </ol>

    <footer class="now-foot">
      <span class="eyebrow">↺ «ahoras» anteriores en el archivo</span>
    </footer>
  </section>
</BaseLayout>
