---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import NowMasthead from '@components/NowMasthead.astro';
import NowItem from '@components/NowItem.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';

const entry = await getEntry('pages', 'es/now');
if (!entry) throw new Error('Missing pages/es/now');
const sibling = await getSibling(entry);
const { title, lede, items = [] } = entry.data;

const path = ROUTES.now.es;
const siblingPath = sibling ? entryRouteFor(sibling) : null;

// Los seis ítems del bench tour viven en
// `src/content/pages/es/now.md` como YAML frontmatter, validado
// por el schema Zod de la colección `pages` en
// `src/content.config.ts`. La actualización semanal es una
// edición de markdown, no de código. El tipo inferido del schema
// es estructuralmente idéntico al `NowPageItem` exportado por
// `NowItem.astro`, así que el spread de abajo type-checkea sin
// cast.
---

<BaseLayout
  title={title}
  locale="es"
  path={path}
  siblingPath={siblingPath}
  {...lede && { description: lede }}
>
  <section class="now wrap">
    <NowMasthead locale="es" />

    <ol class="now-list">
      {
        items.map((item, i) => (
          <NowItem
            position={i + 1}
            kind={item.kind}
            where={item.where}
            title={item.title}
            prose={item.prose}
            detail={item.detail}
          />
        ))
      }
    </ol>
  </section>
</BaseLayout>
