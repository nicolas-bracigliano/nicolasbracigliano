---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import NowMasthead from '@components/NowMasthead.astro';
import NowItem from '@components/NowItem.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';
import { assertNowEntry } from '@lib/now-items';

const entry = await getEntry('pages', 'es/now');
if (!entry) throw new Error('Missing pages/es/now');
// Reduce la discriminated union `pages` a la variante `now`
// para que `entry.data.items` quede tipado como obligatorio.
// Ver `assertNowEntry` — el throw no puede disparar en runtime
// porque Zod ya validó el literal del slug en build.
assertNowEntry(entry);
const sibling = await getSibling(entry);
const { title, lede, items } = entry.data;

const path = ROUTES.now.es;
const siblingPath = sibling ? entryRouteFor(sibling) : null;

// Los ítems viven en `src/content/pages/es/now.md` como YAML
// frontmatter. La cantidad está locked a `NOW_ITEM_COUNT` en
// `src/lib/now-items.ts` y se valida en build via la union Zod
// discriminada de `pages`. Una edición que baje a cinco ítems
// rompe el build — no se le rompe al lector silenciosamente.
---

<BaseLayout
  title={title}
  locale="es"
  path={path}
  siblingPath={siblingPath}
  {...lede && { description: lede }}
>
  <section class="now wrap">
    <NowMasthead locale="es" />

    <ol class="now-list">
      {
        items.map((item, i) => (
          <NowItem
            position={i + 1}
            kind={item.kind}
            where={item.where}
            title={item.title}
            prose={item.prose}
            detail={item.detail}
          />
        ))
      }
    </ol>
  </section>
</BaseLayout>
