---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PiecesMasthead from '@components/PiecesMasthead.astro';
import PieceEntry from '@components/PieceEntry.astro';
import { ROUTES } from '@lib/routes';

// El índice muestra cada ensayo como un excerpt (párrafos del kernel
// + un enlace para seguir leyendo). PieceEntry extrae el kernel
// directamente de `entry.body`, así que no hace falta llamar a
// `render()` acá; sería costo de build para descartar el HTML.
const pieces = (
  await getCollection('pieces', (e) => e.data.lang === 'es' && e.data.status === 'published')
).sort((a, b) => +b.data.date - +a.data.date);

const path = ROUTES.pieces.es;
const siblingPath = ROUTES.pieces.en;
---

<BaseLayout
  title="Ensayos"
  description="Entradas más largas. Cosas que querían más que un párrafo."
  locale="es"
  path={path}
  siblingPath={siblingPath}
>
  <section class="pieces wrap">
    <PiecesMasthead locale="es" />

    {
      pieces.length === 0 ? (
        <p class="pieces-empty">Todavía no hay ensayos — el primero está en el banco.</p>
      ) : (
        <ol class="pieces-list">
          {pieces.map((entry) => (
            <PieceEntry entry={entry} locale="es" />
          ))}
        </ol>
      )
    }

    {
      pieces.length > 0 && (
        <footer class="pieces-foot">
          <span class="eyebrow">↺ &nbsp;ensayos más viejos en el cajón</span>
        </footer>
      )
    }
  </section>
</BaseLayout>
