---
import { getCollection, render } from 'astro:content';
import PieceLayout from '@layouts/PieceLayout.astro';
import { getSibling, entryRouteFor } from '@lib/i18n';

export async function getStaticPaths() {
  const pieces = await getCollection(
    'pieces',
    (e) => e.data.lang === 'es' && e.data.status === 'published',
  );
  return pieces.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const sibling = await getSibling(entry);
const { Content } = await render(entry);
const path = entryRouteFor(entry);
const siblingPath = sibling ? entryRouteFor(sibling) : null;
---

<PieceLayout entry={entry} path={path} siblingPath={siblingPath}>
  <Content />
</PieceLayout>
