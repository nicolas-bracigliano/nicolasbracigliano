---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { ROUTES } from '@lib/routes';
import { entryRouteFor } from '@lib/i18n';

const works = (
  await getCollection('works', (e) => e.data.lang === 'es' && e.data.status === 'published')
).sort((a, b) => +b.data.date - +a.data.date);

const path = ROUTES.works.es;
const siblingPath = ROUTES.works.en;
---

<BaseLayout
  title="Obras"
  description="Proyectos — digitales y físicos."
  locale="es"
  path={path}
  siblingPath={siblingPath}
>
  <section class="index">
    <h1>Obras</h1>
    <ul class="card-list">
      {
        works.map((w) => (
          <li class="card">
            <a href={entryRouteFor(w)}>
              <h2>{w.data.title}</h2>
              {w.data.lede && <p>{w.data.lede}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
