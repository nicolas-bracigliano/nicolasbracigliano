---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import WorksMasthead from '@components/WorksMasthead.astro';
import WorksFilters from '@components/WorksFilters.astro';
import WorkCard from '@components/WorkCard.astro';
import { ROUTES } from '@lib/routes';

const works = (
  await getCollection('works', (e) => e.data.lang === 'es' && e.data.status === 'published')
).sort((a, b) => +b.data.date - +a.data.date);

const path = ROUTES.works.es;
const siblingPath = ROUTES.works.en;
---

<BaseLayout
  title="Obras"
  description="Un catálogo de cosas hechas — digitales y físicas, terminadas y en proceso."
  locale="es"
  path={path}
  siblingPath={siblingPath}
>
  <section class="works wrap">
    <WorksMasthead locale="es" />
    <WorksFilters entries={works} locale="es" />

    <ul class="works-grid" data-active-filter="all">
      {works.map((w) => <WorkCard entry={w} locale="es" />)}
    </ul>
  </section>
</BaseLayout>
