---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import NotesMasthead from '@components/NotesMasthead.astro';
import NoteEntry from '@components/NoteEntry.astro';
import SectionEnd from '@components/SectionEnd.astro';
import { ROUTES } from '@lib/routes';

const notes = (
  await getCollection('notes', (e) => e.data.lang === 'en' && e.data.status === 'published')
).sort((a, b) => +b.data.date - +a.data.date);

// Render each note's MDX content alongside its frontmatter so the index
// reads like a field notebook, not a stack of "read more" stubs.
const rendered = await Promise.all(
  notes.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const path = ROUTES.notes.en;
const siblingPath = ROUTES.notes.es;
---

<BaseLayout
  title="Notes"
  description="Short notes, TILs, micro-posts."
  locale="en"
  path={path}
  siblingPath={siblingPath}
>
  <section class="notes wrap">
    <NotesMasthead locale="en" />

    <ol class="notes-list">
      {
        rendered.map(({ entry, Content }, i) => (
          <NoteEntry entry={entry} locale="en" isFirst={i === 0}>
            <Content />
          </NoteEntry>
        ))
      }
    </ol>

    <SectionEnd note="older notes in the drawer" />
  </section>
</BaseLayout>
