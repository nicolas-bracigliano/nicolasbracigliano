---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { ROUTES } from '@lib/routes';
import { entryRouteFor } from '@lib/i18n';

const notes = (
  await getCollection('notes', (e) => e.data.lang === 'en' && e.data.status === 'published')
).sort((a, b) => +b.data.date - +a.data.date);

const path = ROUTES.notes.en;
const siblingPath = ROUTES.notes.es;
---

<BaseLayout
  title="Notes"
  description="Short notes, TILs, micro-posts."
  locale="en"
  path={path}
  siblingPath={siblingPath}
>
  <section class="index">
    <h1>Notes</h1>
    <ul class="entry-list">
      {
        notes.map((n) => (
          <li>
            <a href={entryRouteFor(n)}>
              <time datetime={n.data.date.toISOString().slice(0, 10)}>
                {n.data.date.toISOString().slice(0, 10)}
              </time>
              <span class="title">{n.data.title}</span>
              {n.data.lede && <span class="lede">{n.data.lede}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
