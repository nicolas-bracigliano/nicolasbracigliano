---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import WorksMasthead from '@components/WorksMasthead.astro';
import WorksFilters from '@components/WorksFilters.astro';
import WorkCard from '@components/WorkCard.astro';
import SectionEnd from '@components/SectionEnd.astro';
import { ROUTES } from '@lib/routes';

const works = (
  await getCollection('works', (e) => e.data.lang === 'en' && e.data.status === 'published')
).sort((a, b) => +b.data.date - +a.data.date);

const path = ROUTES.works.en;
const siblingPath = ROUTES.works.es;
---

<BaseLayout
  title="Works"
  description="A catalog of made things — digital and physical, finished and ongoing."
  locale="en"
  path={path}
  siblingPath={siblingPath}
>
  <section class="works wrap">
    <WorksMasthead locale="en" />
    <WorksFilters entries={works} locale="en" />

    <ul class="works-grid" data-active-filter="all">
      {works.map((w) => <WorkCard entry={w} locale="en" />)}
    </ul>

    {/* DRAFT copy — author to confirm before merge. */}
    {works.length > 0 && <SectionEnd note="more works on the bench" />}
  </section>
</BaseLayout>
