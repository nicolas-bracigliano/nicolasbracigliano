---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import NowMasthead from '@components/NowMasthead.astro';
import NowItem from '@components/NowItem.astro';
import SectionEnd from '@components/SectionEnd.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor, resolveWorkLinks } from '@lib/i18n';
import { assertNowEntry } from '@lib/now-items';

const entry = await getEntry('pages', 'en/now');
if (!entry) throw new Error('Missing pages/en/now');
// Narrow the discriminated `pages` union to the now variant so
// `entry.data.items` is typed as required. See `assertNowEntry`
// for why this can't fire at runtime (Zod's slug literal already
// enforced it at build time).
assertNowEntry(entry);
const sibling = await getSibling(entry);
const { title, lede, items } = entry.data;

const path = ROUTES.now.en;
const siblingPath = sibling ? entryRouteFor(sibling) : null;

// Each item's optional `work` (a work translationId) resolved to its
// localized /works route — see `resolveWorkLinks` (shared with the ES
// page) for the rule, incl. the dangling-ref build failure.
const workLinks = await resolveWorkLinks(items, 'en');

// Items live in `src/content/pages/en/now.md` as YAML frontmatter.
// Count is bounded to NOW_ITEM_MIN..NOW_ITEM_MAX in `src/lib/now-items.ts`
// and validated at build time by the discriminated `pages` Zod schema.
// The teaser'd items also feed the home bench (single source). A content
// edit outside the range fails the build, not silently the user.
---

<BaseLayout
  title={title}
  locale="en"
  path={path}
  siblingPath={siblingPath}
  {...lede && { description: lede }}
>
  <section class="now wrap">
    <NowMasthead locale="en" />

    <ol class="now-list">
      {
        items.map((item, i) => (
          <NowItem
            position={i + 1}
            kind={item.kind}
            where={item.where}
            title={item.title}
            prose={item.prose}
            detail={item.detail}
            workHref={workLinks[i]?.href}
            workLabel={workLinks[i]?.label}
            seeAlsoLabel="see also"
          />
        ))
      }
    </ol>

    {
      /* DRAFT copy — author to confirm before merge. Echoes §7's
        "replace, don't append" convention for /now. */
    }
    <SectionEnd note="replaced, not appended" />
  </section>
</BaseLayout>
