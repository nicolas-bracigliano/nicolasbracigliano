---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import NowMasthead from '@components/NowMasthead.astro';
import NowItem from '@components/NowItem.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';

const entry = await getEntry('pages', 'en/now');
if (!entry) throw new Error('Missing pages/en/now');
const sibling = await getSibling(entry);
const { title, lede, items = [] } = entry.data;

const path = ROUTES.now.en;
const siblingPath = sibling ? entryRouteFor(sibling) : null;

// The six bench-tour items live in `src/content/pages/en/now.md`
// as YAML frontmatter, validated by the `pages` collection's Zod
// schema in `src/content.config.ts`. Weekly content refresh is a
// markdown edit, not a code change. The schema's inferred type
// for each item is structurally identical to `NowPageItem` from
// `NowItem.astro` so the spread below type-checks without a cast.
---

<BaseLayout
  title={title}
  locale="en"
  path={path}
  siblingPath={siblingPath}
  {...lede && { description: lede }}
>
  <section class="now wrap">
    <NowMasthead locale="en" />

    <ol class="now-list">
      {
        items.map((item, i) => (
          <NowItem
            position={i + 1}
            kind={item.kind}
            where={item.where}
            title={item.title}
            prose={item.prose}
            detail={item.detail}
          />
        ))
      }
    </ol>
  </section>
</BaseLayout>
