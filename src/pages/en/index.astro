---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Masthead from '@components/Masthead.astro';
import Bench from '@components/Bench.astro';
import LatestEntries from '@components/LatestEntries.astro';
import FieldNotesSidebar from '@components/FieldNotesSidebar.astro';
import Coffee from '@components/Coffee.astro';
import Mate from '@components/Mate.astro';
import { ROUTES } from '@lib/routes';
import { FEEDS } from '@lib/feeds';
import { getSibling, entryRouteFor } from '@lib/i18n';
import { assertNowEntry, benchItemsFrom } from '@lib/now-items';
import { buildLatest } from '@lib/latest-entries';
import { VERSION } from '@lib/version';

const entry = await getEntry('pages', 'en/home');
if (!entry) throw new Error('Missing pages/en/home');
const sibling = await getSibling(entry);
const { title, lede } = entry.data;

// "Currently on the bench" is derived from the /now items that carry a
// `teaser` — now.md is the single source for both the bench grid and the
// full /now tour (replaces the old hand-synced `bench:` array on home.md,
// which had drifted from /now). See ADR 0014.
const nowEntry = await getEntry('pages', 'en/now');
if (!nowEntry) throw new Error('Missing pages/en/now');
assertNowEntry(nowEntry);
const bench = benchItemsFrom(nowEntry.data.items);

// Latest two of each kind, grouped work → piece → note by buildLatest,
// which keys on every feed kind — so dropping a collection here is a
// compile error.
const [notes, works, pieces] = await Promise.all([
  getCollection('notes', (e) => e.data.lang === 'en' && e.data.status === 'published'),
  getCollection('works', (e) => e.data.lang === 'en' && e.data.status === 'published'),
  getCollection('pieces', (e) => e.data.lang === 'en' && e.data.status === 'published'),
]);
const latest = buildLatest({ note: notes, work: works, piece: pieces });

// Feed hrefs come from `@lib/feeds`, the same source BaseLayout's
// autodiscovery <link> and the two feed routes read. Typed out here they sat
// outside every guard: `tests/unit/feeds.test.ts` pins FEEDS.path against the
// route file that builds it, so renaming `rss-en.xml.ts` and FEEDS.en.path in
// step stays green while these two links quietly 404.
// `tests/unit/feed-path-single-source.test.ts` fails on a reintroduced literal.
// Labels are author copy; only the hrefs are derived.
const elsewhere = [
  { label: 'github', href: 'https://github.com/nicolas-bracigliano' },
  { label: 'maker world', href: 'https://makerworld.com/en/@NicoBrachi' },
  { label: 'rss.xml', href: FEEDS.en.path, suffix: '(en)' },
  { label: 'rss.xml', href: FEEDS.es.path, suffix: '(es)' },
];

const reading = [{ title: 'Nexus', author: 'Yuval Noah Harari' }];
---

<BaseLayout
  title={title}
  locale="en"
  path={ROUTES.home.en}
  siblingPath={sibling ? entryRouteFor(sibling) : null}
  {...lede && { description: lede }}
>
  <article class="home">
    <Masthead portraitCaption="">
      <Fragment slot="eyebrow">
        Nicolás&nbsp;Bracigliano
        <span class="sep">·</span>
        <span class="dot mate" aria-hidden="true"></span>
        Melbourne,&nbsp;AU
        <span class="sep">·</span>
        <span class="now-time" data-now-melbourne>—:—</span>
      </Fragment>

      <h1 slot="h1">
        I make <em>things</em>
        <br />
        on screens,
        <br />
        <span class="indent">useful</span> things
        <br />
        at home,
        <br />
        <span class="indent2">and <Coffee label="a long black" /></span>
        <br />
        every morning.
      </h1>

      <Fragment slot="bio">
        Senior software engineer, coding since 2006. Off-screen: guitar, garden, pool, gym, 3D
        printing. Argentinian, so there's always <Mate /> on the desk. Audiobook in one ear, secateurs
        in the other. This is the <em>colophon</em>: where the work, the drafts, and the tries live.
      </Fragment>

      <Fragment slot="meta">
        <span>en proceso, en público</span>
        <span class="sep">·</span>
        <span>v.{VERSION}</span>
      </Fragment>
    </Masthead>

    <Bench items={bench} locale="en" />

    {
      latest.length > 0 && (
        <LatestEntries
          items={latest}
          eyebrow="Latest entries"
          descriptorLead="two of each"
          allLinksByKind={{
            work: { label: 'all works →', href: ROUTES.works.en },
            piece: { label: 'all pieces →', href: ROUTES.pieces.en },
            note: { label: 'all notes →', href: ROUTES.notes.en },
          }}
          locale="en"
          kindLabels={{ note: 'note', work: 'work', piece: 'piece' }}
        />
      )
    }

    <FieldNotesSidebar
      elsewhereLabel="Elsewhere"
      readingLabel="Reading right now"
      cupLabel="In the cup"
      elsewhere={elsewhere}
      reading={reading}
    >
      <Fragment slot="cup">
        <p class="cup">
          <Coffee />
          &nbsp;Brimstone, CommonFolks — <span class="muted">blend · Uganda, Kenya.</span>
        </p>
        <p class="cup">
          <Mate />
          &nbsp;La Merced, Monte — <span class="muted">amargo, siempre.</span>
        </p>
      </Fragment>
    </FieldNotesSidebar>
  </article>

  <script>
    // Live Melbourne wall-clock in the masthead eyebrow.
    // Tick chain self-arms on astro:page-load and self-stops when the
    // element is gone (i.e. navigated off home), so no accumulators
    // across <ClientRouter /> page swaps.
    const fmt = new Intl.DateTimeFormat('en-AU', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Australia/Melbourne',
    });
    function paintNow(): boolean {
      const el = document.querySelector<HTMLElement>('[data-now-melbourne]');
      if (!el) return false;
      el.textContent = fmt.format(new Date());
      return true;
    }
    function tick(): void {
      if (paintNow()) setTimeout(tick, 60_000);
    }

    // Bench vignettes — animate-once-on-mount, triggered when each card
    // is at least 20% in view. Plays one staged animation per card per
    // visit (DS §15: no looping vignettes). The observer unobserves
    // after the first hit so the animation doesn't re-fire on scroll-
    // back. Fresh page-load (incl. ClientRouter navigations back to
    // home) gets a fresh observer so the bench feels alive each visit.
    function armBenchObserver(): void {
      const cards = document.querySelectorAll<HTMLElement>('.bench-card');
      if (cards.length === 0) return;
      if (!('IntersectionObserver' in window)) {
        cards.forEach((c) => c.classList.add('in-view'));
        return;
      }
      const obs = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 },
      );
      cards.forEach((c) => obs.observe(c));
    }

    document.addEventListener('astro:page-load', () => {
      armBenchObserver();
      if (!paintNow()) return;
      setTimeout(tick, (60 - new Date().getSeconds()) * 1000);
    });
  </script>
</BaseLayout>
