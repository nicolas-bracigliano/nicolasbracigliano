---
import { getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ColophonMasthead from '@components/ColophonMasthead.astro';
import ColophonSection from '@components/ColophonSection.astro';
import ColophonRow from '@components/ColophonRow.astro';
import AsciiSignature from '@components/AsciiSignature.astro';
import { ROUTES } from '@lib/routes';
import { getSibling, entryRouteFor } from '@lib/i18n';

const entry = await getEntry('pages', 'en/colophon');
if (!entry) throw new Error('Missing pages/en/colophon');
const sibling = await getSibling(entry);
const { title, lede } = entry.data;

const path = ROUTES.colophon.en;
const siblingPath = sibling ? entryRouteFor(sibling) : null;
---

<BaseLayout
  title={title}
  locale="en"
  path={path}
  siblingPath={siblingPath}
  {...lede && { description: lede }}
>
  <section class="colofon wrap">
    <ColophonMasthead locale="en" />

    <ColophonSection tag="01" title="Built with">
      <ColophonRow dt="language">html · css · typescript (no framework on the page)</ColophonRow>
      <ColophonRow dt="generator">
        <a href="/en/works/this-site/">astro 6</a> · static output · near-zero JS
      </ColophonRow>
      <ColophonRow dt="tested">playwright in chromium · axe-core a11y · lighthouse ci</ColophonRow>
      <ColophonRow dt="search">⌘K palette · navigation index, no full-text</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="02" title="Set in">
      <ColophonRow dt="headline">
        <span class="serif">Newsreader</span> · variable, 200–800
      </ColophonRow>
      <ColophonRow dt="body">
        <span class="mono-display">JetBrains Mono</span> · weight 400
      </ColophonRow>
      <ColophonRow dt="fallbacks">iowan old style, georgia · ui-monospace, menlo</ColophonRow>
      <ColophonRow dt="a11y">min 15 px body · 1.55 line height · contrast AA+</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="03" title="Hosted on">
      <ColophonRow dt="serves">cloudflare workers · static assets</ColophonRow>
      <ColophonRow dt="assets">self-hosted fonts · no third-party scripts</ColophonRow>
      <ColophonRow dt="privacy">no cookies · no analytics · no beacon</ColophonRow>
      <ColophonRow dt="dns">cloudflare · DNSSEC + HSTS preload</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="04" title="Workflow">
      <ColophonRow dt="write">markdown in /src/content, typed via Zod</ColophonRow>
      <ColophonRow dt="preview">astro dev · livereload on save</ColophonRow>
      <ColophonRow dt="publish">git push → github actions → wrangler deploy</ColophonRow>
      <ColophonRow dt="draft">a status in frontmatter, kept out of the build</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="05" title="Principles" accent>
      <ColophonRow dt="hecho a mano">every page shows craft. nothing is templated.</ColophonRow>
      <ColophonRow dt="one maker, many crafts">
        code, guitar, garden, 3D: facets of one person.
      </ColophonRow>
      <ColophonRow dt="tools are visible">this page exists for that reason.</ColophonRow>
      <ColophonRow dt="en público, en proceso">
        drafts welcome. seedlings tended openly.
      </ColophonRow>
      <ColophonRow dt="curiosity over conclusion">titles can be questions.</ColophonRow>
      <ColophonRow dt="perf, a11y, security">as aesthetics, not as checkboxes.</ColophonRow>
    </ColophonSection>

    <ColophonSection tag="06" title="The desk">
      <ColophonRow dt="fuel">mate all day · a long black every morning</ColophonRow>
    </ColophonSection>

    <AsciiSignature locale="en" />
  </section>
</BaseLayout>
