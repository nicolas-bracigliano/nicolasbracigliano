---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PiecesMasthead from '@components/PiecesMasthead.astro';
import PieceEntry from '@components/PieceEntry.astro';
import { ROUTES } from '@lib/routes';

// The index renders each piece as a row (meta + title + lede + tags,
// per ADR 0012). PieceEntry only needs frontmatter plus the raw
// `entry.body` (for read-time), so we don't call `render()` here —
// that's build cost we'd pay just to throw away the rendered HTML.
const pieces = (
  await getCollection('pieces', (e) => e.data.lang === 'en' && e.data.status === 'published')
).sort((a, b) => +b.data.date - +a.data.date);

const path = ROUTES.pieces.en;
const siblingPath = ROUTES.pieces.es;
---

<BaseLayout
  title="Pieces"
  description="Longer entries. Things that wanted more than a paragraph."
  locale="en"
  path={path}
  siblingPath={siblingPath}
>
  <section class="pieces wrap">
    <PiecesMasthead locale="en" />

    {
      pieces.length === 0 ? (
        <p class="pieces-empty">No pieces yet — the first one is on the bench.</p>
      ) : (
        <ol class="pieces-list">
          {pieces.map((entry) => (
            <PieceEntry entry={entry} locale="en" />
          ))}
        </ol>
      )
    }

    {
      pieces.length > 0 && (
        <footer class="pieces-foot">
          <span class="eyebrow">↺ &nbsp;older pieces in the drawer</span>
        </footer>
      )
    }
  </section>
</BaseLayout>
