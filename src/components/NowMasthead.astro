---
import type { Locale } from '@lib/routes';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  en: {
    eyebrow: '/ about / now',
    h1Lead: "What I'm doing",
    h1Italic: 'right now.',
    dateLocale: 'en-AU',
    updated: 'last updated this week',
    sub: 'A "now" page — present tense, honest. Not a portfolio. A bench&nbsp;tour.',
  },
  es: {
    eyebrow: '/ sobre / ahora',
    h1Lead: 'Qué estoy haciendo',
    h1Italic: 'ahora mismo.',
    dateLocale: 'es-AR',
    updated: 'última actualización esta semana',
    sub: 'Ahora — tiempo presente, honesta. No es un portfolio. Es un recorrido por la&nbsp;mesa.',
  },
} as const;

const t = copy[locale];

// Long-form local date, tied to Australia/Melbourne so the byline
// matches what's actually on the bench from Nicolas's chair. Locale-
// formatted: "Friday, 23 May 2026" (en-AU) / "viernes, 23 de mayo de
// 2026" (es-AR). Lowercased to match the page's quiet voice.
//
// Deliberately frozen at build time. A visitor landing two days
// after the build sees the build date, not "right now". The
// `t.updated` line ("last updated this week" / "última actualización
// esta semana") is the explicit framing that handles this — the
// page is a refreshed-weekly snapshot, not a live clock. Don't
// "fix" the staleness by client-rendering the date: that adds JS to
// a route the budget keeps at zero and conflicts with the same
// rationale as the home page's wall-clock decisions.
const dateLong = new Intl.DateTimeFormat(t.dateLocale, {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Australia/Melbourne',
})
  .format(new Date())
  .toLowerCase();
---

<header class="now-head">
  <span class="eyebrow">{t.eyebrow}</span>
  <h1 class="now-h1">
    {t.h1Lead}
    <br />
    <span class="serif-italic">{t.h1Italic}</span>
  </h1>
  <p class="now-date">
    {dateLong} · <span class="muted">{t.updated}</span>
  </p>
  <p class="now-sub" set:html={t.sub} />
</header>
