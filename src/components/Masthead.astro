---
// Home-page masthead (design system §3 — Workshop bench). Two columns
// on desktop: line-art portrait + caption on the left, big serif h1
// + bio + meta on the right. Single column under 720px.
//
// Eyebrow, h1, bio and meta are slots so the page can compose locale-
// specific copy with inline <Coffee /> + <Mate /> vignettes. The
// portrait is the inline linocut SVG (`Portrait.astro`); the wrapping
// markup is component-agnostic, so swapping it for an <Image /> would
// be a one-line change.

import Portrait from '@components/Portrait.astro';

export interface Props {
  /** Caption beneath the portrait. */
  portraitCaption: string;
}

const { portraitCaption } = Astro.props;
---

<section class="masthead">
  <div class="masthead-grid">
    <aside class="masthead-portrait" aria-hidden="true">
      <Portrait class="masthead-portrait-art" />
      {portraitCaption && <p class="portrait-caption">{portraitCaption}</p>}
    </aside>

    <div class="masthead-text">
      <p class="eyebrow"><slot name="eyebrow" /></p>
      <slot name="h1" />
      <p class="masthead-bio"><slot name="bio" /></p>
      <p class="masthead-meta"><slot name="meta" /></p>
    </div>
  </div>
</section>
