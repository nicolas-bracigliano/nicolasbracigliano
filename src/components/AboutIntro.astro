---
// First-visit overlay on /about/ — a single italic "hola." that
// dissolves into the masthead. Markup ships in static HTML so the
// effect doesn't depend on JS reaching the page; CSS @keyframes
// drives the auto-dismiss. JS layer handles:
//   - sessionStorage skip on subsequent visits within the same tab
//   - click / Esc early dismissal
//   - removing the element from the DOM after it fades out (so
//     trailing `pointer-events: none` + a hidden node don't sit on
//     top of `.about` forever and interfere with the inspector)
//
// Accessibility: the overlay is `aria-hidden` and `role="presentation"`
// — screen readers skip it entirely; the actual "Hola." that drives the
// page is the masthead h1 below.
//
// `prefers-reduced-motion`: the global reset clamps animation-duration
// to 0.01 ms, so reduced-motion users get the overlay for one frame
// and then it's gone. No motion exposure.
---

<div class="about-intro" role="presentation" aria-hidden="true" data-about-intro>
  <span class="about-intro-hola serif-italic">hola.</span>
</div>

<script>
  function wireIntro(): void {
    const intro = document.querySelector<HTMLElement>('[data-about-intro]');
    if (!intro) return;

    // Once-per-tab: if the visitor has already seen the overlay this
    // session, skip the animation and remove the node before paint.
    try {
      if (sessionStorage.getItem('about-intro-seen') === 'true') {
        intro.remove();
        return;
      }
      sessionStorage.setItem('about-intro-seen', 'true');
    } catch {
      /* sessionStorage unavailable — fall through and play the intro */
    }

    const dismiss = (): void => {
      if (intro.classList.contains('is-dismissed')) return;
      intro.classList.add('is-dismissed');
    };

    // Clean up after the CSS animation completes (either auto-fade or
    // is-dismissed). Listen for both so the click/Esc path also clears.
    intro.addEventListener(
      'animationend',
      () => {
        intro.remove();
      },
      { once: true },
    );

    intro.addEventListener('click', dismiss);
    const onKey = (e: KeyboardEvent): void => {
      if (e.key === 'Escape') {
        dismiss();
        window.removeEventListener('keydown', onKey);
      }
    };
    window.addEventListener('keydown', onKey);
  }
  document.addEventListener('astro:page-load', wireIntro);
</script>
