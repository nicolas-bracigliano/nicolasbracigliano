---
// First-visit overlay on /about/ — a single italic "hola." that
// softly pulses outward and dissolves into the page below.
//
// Architecture: CSS drives the auto-dismiss (a `@keyframes
// about-intro-out` on `.about-intro` with `animation-fill-mode:
// forwards`); JS owns sessionStorage + click/Esc early-dismiss + DOM
// cleanup on `animationend`. The overlay markup ships in static HTML —
// if JS never runs, the CSS animation still fades it out, so the
// intro never traps a visitor behind it.
//
// **Note: not extracted as a reusable `<IntroOverlay>`** — the
// timing curve, the `hola.` copy, and the morph all couple tightly
// to the about page's masthead identity. If a similar effect ever
// lands on another route, this is the file to copy + adapt, not a
// shared component to parameterise.
//
// A11y:
// - `role="presentation"` + `aria-hidden="true"` — screen readers
//   skip the overlay entirely; the actual "Hola." that drives the
//   page is the masthead `<h1>` below.
// - The global `prefers-reduced-motion: reduce` clamp in reset.css
//   drops the animation-duration to 0.01 ms, so reduced-motion users
//   see the overlay for one frame and it's gone. No motion exposure.
//
// History: an earlier version translated the word up-and-left toward
// the masthead AND used an SVG turbulence + displacement filter for a
// particle dissolve. Both were dropped:
// - Translate was abandoned because the masthead-position target
//   only worked at desktop viewport sizes (translate values were
//   viewport-relative magic numbers tuned to 1280×900).
// - SVG filter was dropped because (a) SMIL is officially deprecated
//   and (b) the GPU cost of feTurbulence + feDisplacementMap stutters
//   on lower-end devices. CSS `filter: blur()` reads as a soft
//   dissolve at much lower cost and is fully spec-stable.
---

<div class="about-intro" role="presentation" aria-hidden="true" data-about-intro>
  <span class="about-intro-hola serif-italic">hola<span class="about-intro-dot">.</span></span>
</div>

<script>
  function wireIntro(): void {
    const intro = document.querySelector<HTMLElement>('[data-about-intro]');
    if (!intro) return;

    // Once-per-tab: if the visitor has already seen the overlay this
    // session, skip the animation and remove the node before paint.
    try {
      if (sessionStorage.getItem('about-intro-seen') === 'true') {
        intro.remove();
        return;
      }
      sessionStorage.setItem('about-intro-seen', 'true');
    } catch {
      /* sessionStorage unavailable — fall through and play the intro */
    }

    const dismiss = (): void => {
      if (intro.classList.contains('is-dismissed')) return;
      intro.classList.add('is-dismissed');
    };

    // Clean up after the OVERLAY'S OWN out-animation completes — not
    // when a child animation (hola fade-in / morph) bubbles up. We
    // can't use `{ once: true }` because the first bubbled animationend
    // would be `about-intro-hola-in` at ~900 ms, tearing down the
    // intro long before the overlay finishes dissolving.
    intro.addEventListener('animationend', (event) => {
      const name = (event as AnimationEvent).animationName;
      if (name === 'about-intro-out' || name === 'about-intro-dismiss') {
        intro.remove();
      }
    });

    intro.addEventListener('click', dismiss);
    const onKey = (e: KeyboardEvent): void => {
      if (e.key === 'Escape') {
        dismiss();
        window.removeEventListener('keydown', onKey);
      }
    };
    window.addEventListener('keydown', onKey);
  }
  document.addEventListener('astro:page-load', wireIntro);
</script>
