---
// Default vignette for `kind: print` works: an isometric Gridfinity
// baseplate with modular bins of different footprints and heights —
// the 42 mm grid, the dropped-in bins, the stacking lip on top. Single-
// colour via `currentColor` (ink-blue); depth comes from a different
// fill-opacity per face (top lightest, sides darker). Geometry is shared
// with the home bench vignette via `@lib/gridfinity-vignette` so the two
// can't drift; this component just lays out the faces statically.
import { bins, plane, gridLines, plateRight, plateLeft } from '@lib/gridfinity-vignette';
---

<svg
  viewBox="0 0 200 140"
  width="100%"
  height="100%"
  role="img"
  aria-label="isometric Gridfinity bins"
>
  <title>Gridfinity bins</title>
  <g
    fill="currentColor"
    stroke="currentColor"
    stroke-width="1"
    stroke-linejoin="round"
    stroke-opacity="0.85"
  >
    {/* baseplate thickness (drawn first — it sits lowest) */}
    <polygon points={plateRight} fill-opacity="0.34"></polygon>
    <polygon points={plateLeft} fill-opacity="0.22"></polygon>

    {/* baseplate top plane + the 42 mm grid */}
    <polygon points={plane} fill-opacity="0.05" stroke-opacity="0.5"></polygon>
    <g fill="none" stroke-opacity="0.22">
      {gridLines.map((d) => <path d={d} />)}
    </g>

    {/* bins, back-to-front */}
    {
      bins.map((b) => (
        <g>
          <polygon points={b.left} fill-opacity="0.18" />
          <polygon points={b.right} fill-opacity="0.32" />
          <polygon points={b.top} fill-opacity="0.1" />
          <polygon points={b.lip} fill="none" stroke-opacity="0.5" />
        </g>
      ))
    }
  </g>
</svg>
