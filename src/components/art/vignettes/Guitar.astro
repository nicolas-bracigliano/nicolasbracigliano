---
// `kind: guitar` vignette — a fretboard: nut, frets, six strings in
// graduated gauges (heavy low-E to thin high-e) over a faint board with
// position-marker inlays, and an accent chord shape.
//
// SINGLE SOURCE for both surfaces (ADR 0013 amendment): the works registry
// renders it via ContentArt with no props; the home bench renders the same
// file with `class="guitar-vig"` (which scopes the string strum,
// `.guitar-vig .string`, animations.css) and a `label` baked into the
// caption. Strings carry `.string sN` so the bench can stagger the strum.
export interface Props {
  class?: string;
  label?: string | undefined;
}
const { class: className = '', label } = Astro.props;
---

<svg viewBox="0 0 220 140" width="100%" height="100%" class={className} aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-width="1">
    {/* fretboard + nut */}
    <rect
      x="20"
      y="16"
      width="194"
      height="90"
      fill="currentColor"
      fill-opacity="0.05"
      stroke="none"></rect>
    <line x1="23" x2="23" y1="17" y2="105" stroke-width="3.5" opacity="0.55"></line>
    {/* frets */}
    <line x1="70" x2="70" y1="17" y2="105" stroke-width="2" opacity="0.4"></line>
    <line x1="120" x2="120" y1="17" y2="105" stroke-width="2" opacity="0.4"></line>
    <line x1="170" x2="170" y1="17" y2="105" stroke-width="2" opacity="0.4"></line>
    {/* position-marker inlays */}
    <circle cx="95" cy="61" r="2.6" fill="currentColor" stroke="none" opacity="0.26"></circle>
    <circle cx="195" cy="61" r="2.6" fill="currentColor" stroke="none" opacity="0.26"></circle>
    {/* strings, low → high (heavier → lighter gauge) */}
    <line class="string s0" x1="23" x2="212" y1="24" y2="24" stroke-width="1.7"></line>
    <line class="string s1" x1="23" x2="212" y1="39" y2="39" stroke-width="1.45"></line>
    <line class="string s2" x1="23" x2="212" y1="54" y2="54" stroke-width="1.2"></line>
    <line class="string s3" x1="23" x2="212" y1="69" y2="69" stroke-width="1"></line>
    <line class="string s4" x1="23" x2="212" y1="84" y2="84" stroke-width="0.85"></line>
    <line class="string s5" x1="23" x2="212" y1="99" y2="99" stroke-width="0.7"></line>
    {/* fretted notes (a chord shape) */}
    <circle cx="95" cy="39" r="4" fill="var(--accent)" stroke="none"></circle>
    <circle cx="145" cy="69" r="4" fill="var(--accent)" stroke="none"></circle>
    <circle cx="145" cy="84" r="4" fill="var(--accent)" stroke="none"></circle>
  </g>
  {
    label && (
      <text x="10" y="134" fill="currentColor" font-size="9" opacity="0.6">
        {label}
      </text>
    )
  }
</svg>
