---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@lib/routes';
import { entryRouteFor } from '@lib/i18n';
import { readingTimeMinutes } from '@lib/reading-time';
import MarginNote from './MarginNote.astro';
import ContentArt from './ContentArt.astro';

export interface Props {
  entry: CollectionEntry<'notes'>;
  locale: Locale;
  /** If true, this is the first note in a list — gets a star margin-mark instead of arrow. */
  isFirst?: boolean;
}

// Index-row renderer only. The slug page used to reuse this component
// (via an `isStandalone` prop); it now has its own composition in
// `NoteDetail.astro`, so the index and the detail page diverge cleanly
// — same split pieces made in ADR 0012.
const { entry, locale, isFirst = false } = Astro.props;
const { date, tags, title, lede, aside, minutes: minutesOverride } = entry.data;
const permalink = entryRouteFor(entry);
// Manual override wins; else compute from raw markdown. `entry.body` is
// `string | undefined` per Astro's CollectionEntry type — if absent (loader
// edge case), we hide the read-time span rather than report a fake "1 min".
const minutes = minutesOverride ?? (entry.body ? readingTimeMinutes(entry.body) : null);

const dateFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-AR' : 'en-AU', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
// "2026 · 05 · 18" — split the formatter output and rejoin with bullets.
const dateParts = dateFormatter.formatToParts(date).filter((p) => p.type !== 'literal');
const dateDisplay = `${dateParts.find((p) => p.type === 'year')?.value} · ${dateParts.find((p) => p.type === 'month')?.value} · ${dateParts.find((p) => p.type === 'day')?.value}`;

const readTimeLabel = locale === 'es' ? 'lectura' : 'read time';
const minLabel = locale === 'es' ? 'min' : 'min';
const permalinkLabel = locale === 'es' ? 'enlace' : 'link';
---

<li class="note">
  {
    /* `<div>` not `<aside>` — note-left/note-right are visual rails inside
      an `<article>`, not page-level supplementary landmarks. html-validate's
      unique-landmark rule rightly flags N asides on a list of N notes. */
  }
  <div class="note-left">
    <div class="note-date">{dateDisplay}</div>
    {
      tags && tags.length > 0 && (
        <div class="note-tags">
          {tags.map((t) => (
            <span class="note-tag">#{t}</span>
          ))}
        </div>
      )
    }
    <ContentArt entry={entry} />
  </div>

  <article class="note-body">
    <h2 class="note-title">
      <a href={permalink} data-astro-prefetch>{title}</a>
    </h2>
    {lede && <p class="note-lede">{lede}</p>}
    <div class="note-prose">
      <slot />
    </div>
    {
      /* The permalink always renders on the index; read-time joins it
         when a body exists to compute from (`minutes === null` is the
         loader edge case noted above). */
    }
    <div class="note-foot">
      {
        minutes !== null && (
          <>
            <span>
              {readTimeLabel} · {minutes} {minLabel}
            </span>
            <span class="sep">·</span>
          </>
        )
      }
      <a href={permalink}>
        {permalinkLabel}
        <span class="visually-hidden">: {title}</span>
      </a>
    </div>
  </article>

  <div class="note-right">
    {aside && <MarginNote text={aside} mark={isFirst ? '✸' : '↳'} />}
  </div>
</li>
