---
// C4 overview "wheel" — a circle divided into four quadrants for the
// four C4 abstraction levels (Context · Container · Component · Code).
// Use as the orienting visual at the top of a C4-related piece; the
// per-level detail lives in `C4Level.astro`.
export interface Props {
  caption?: string;
  label?: string;
}
const { caption, label } = Astro.props;
const labelled = label !== undefined;
---

<figure
  class="diagram diagram--c4-wheel"
  {...labelled ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }}
>
  <svg viewBox="0 0 240 240" width="100%" preserveAspectRatio="xMidYMid meet">
    {label && <title>{label}</title>}
    {/* Outer circle + cross-dividers — the grid scaffold. */}
    <g class="d-grid" fill="none" stroke-width="1.5">
      <circle cx="120" cy="120" r="100"></circle>
      <line x1="20" y1="120" x2="220" y2="120"></line>
      <line x1="120" y1="20" x2="120" y2="220"></line>
    </g>
    {/* Centre hub circle — focal accent, paired with the "C4" mark. */}
    <g class="d-hub" stroke-width="0.6" opacity="1">
      <circle cx="120" cy="120" r="36"></circle>
    </g>
    {/* Quadrant labels + numeric markers — sit on the grid in label colour. */}
    <g class="d-label" font-size="11" text-anchor="middle">
      <text x="70" y="72">Context</text>
      <text x="170" y="72">Container</text>
      <text x="170" y="172">Component</text>
      <text x="70" y="172">Code</text>
    </g>
    <g class="d-label" font-style="italic" font-size="7" opacity="0.7" text-anchor="middle">
      <text x="70" y="86">1</text>
      <text x="170" y="86">2</text>
      <text x="170" y="186">3</text>
      <text x="70" y="186">4</text>
    </g>

    {
      /* Centre "C4" mark — sits on the hub, takes the hub colour. The
        text needs `fill: var(--c-hub)` not the hub's stroke role, so
        we override via a separate inline-style hook. Simpler: re-use
        the d-hub class — its CSS sets `fill` too. */
    }
    <g class="d-hub" font-size="24" font-weight="900" text-anchor="middle">
      <text x="120" y="128">C4</text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
