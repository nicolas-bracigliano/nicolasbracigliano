---
// Clean Architecture's four concentric rings — Entities (innermost),
// Use Cases, Interface Adapters, Frameworks & Drivers (outermost).
// The inward-pointing arrow is the Dependency Rule visualised: source
// code dependencies point only inward.
//
// Pure SVG. Colour comes from the wrapping `<figure class="diagram
// diagram--rings">` via CSS variable. Font + text styling come from
// `.diagram svg text` rules in `pieces.css` — keeping CSS-variable
// resolution in a CSS rule (not an SVG presentation attribute, which
// is inconsistently honoured for `var()` references).
//
// `aria-hidden` by default; if `label` is provided, the figure becomes
// `role="img"` with the label and the SVG carries a `<title>` so the
// diagram is accessible both via screen reader and as standalone SVG.
export interface Props {
  /** Optional visible caption below the diagram. */
  caption?: string;
  /** Optional accessible label. When set, the diagram stops being
   *  `aria-hidden` and announces itself to screen readers. */
  label?: string;
}
const { caption, label } = Astro.props;
const labelled = label !== undefined;
---

<figure
  class="diagram diagram--rings"
  {...labelled ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }}
>
  <svg viewBox="0 0 250 250" width="100%" height="auto" preserveAspectRatio="xMidYMid meet">
    {label && <title>{label}</title>}
    <g class="d-rings" fill="none" opacity="0.5" stroke-width="1.2">
      <circle cx="120" cy="120" r="108"></circle>
      <circle cx="120" cy="120" r="80"></circle>
      <circle cx="120" cy="120" r="52"></circle>
      <circle cx="120" cy="120" r="24"></circle>
    </g>
    <g class="d-label" font-size="7" text-anchor="middle">
      <text x="120" y="122">Entities</text>
      <text x="120" y="88">Use Cases</text>
      <text x="120" y="61">Interface Adapters</text>
      <text x="120" y="32">Frameworks &amp; Drivers</text>
    </g>
    {/* Dependency-rule arrow: points inward, top → centre. */}
    <g class="d-arrow">
      <g fill="none" stroke-width="1.2" stroke-linecap="round">
        <path d="M300 120 L 145 120"></path>
        <path d="M152 114 L 145 120 L 152 126"></path>
      </g>
      <text
        x="199"
        y="113"
        font-style="italic"
        font-size="6"
        stroke-width="0.3"
        text-anchor="middle">Source Code Dependencies</text
      >
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
