---
// "Road knot" illustration — a tangled path on the left that slowly
// straightens into a clean line on the right. Visual shorthand for the
// chaos-to-clarity journey the agile piece is about. No literal arrows
// or labels — the metaphor carries it.
export interface Props {
  caption?: string;
  label?: string;
}
const { caption, label } = Astro.props;
const labelled = label !== undefined;
---

<figure
  class="diagram diagram--road-knot"
  {...labelled ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }}
>
  <svg viewBox="0 0 320 140" width="100%" height="auto" preserveAspectRatio="xMidYMid meet">
    {label && <title>{label}</title>}
    {
      /* Knotted side — three crossing curves on the left half. Warm
        accent reads as the chaotic origin. */
    }
    <g class="d-knot" fill="none" stroke-width="1.4" stroke-linecap="round">
      <path d="M20 70 C 40 30, 70 110, 90 60 S 50 100, 80 70 S 100 40, 110 70"></path>
      <path d="M30 90 C 60 60, 50 30, 80 50 S 110 90, 100 70" opacity="0.7"></path>
      <path d="M40 50 C 60 80, 90 50, 100 80" opacity="0.5"></path>
    </g>
    {/* Bridge segment — faded mid-tone, the transition. */}
    <g class="d-bridge" fill="none" stroke-width="1.4" stroke-linecap="round">
      <path d="M110 70 C 140 70, 160 65, 180 68" stroke-dasharray="3 3" opacity="0.6"></path>
    </g>
    {
      /* Clear side — straight line + arrowhead. Calm ink resolves the
        narrative ("where it should land"). */
    }
    <g class="d-clear" fill="none" stroke-width="1.4" stroke-linecap="round">
      <path d="M180 68 L 300 68"></path>
      <path d="M292 62 L 300 68 L 292 74"></path>
    </g>
    <g class="d-label" font-style="italic" font-size="9" opacity="0.7">
      <text x="20" y="120">where it usually starts</text>
      <text x="300" y="120" text-anchor="end">where it should land</text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
