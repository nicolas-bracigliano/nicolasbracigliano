---
// C4 single-level detail. One component, four levels — pick via the
// `level` prop. The visual vocabulary (nested rectangles + connecting
// lines) is shared across levels; each level zooms in one step.
//
// Level 1 (Context): a central system surrounded by users + external systems.
// Level 2 (Container): the system zoomed in to show internal containers.
// Level 3 (Component): one container zoomed in to show its components.
// Level 4 (Code): one component zoomed in to show its classes.
export interface Props {
  level: 1 | 2 | 3 | 4;
  caption?: string;
  label?: string;
}
const { level, caption, label } = Astro.props;
const labelled = label !== undefined;
const LEVEL_NAME: Record<Props['level'], string> = {
  1: 'Context',
  2: 'Container',
  3: 'Component',
  4: 'Code',
};
---

<figure
  class={`diagram diagram--c4-level diagram--c4-level-${level}`}
  {...labelled ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }}
>
  <svg viewBox="0 0 320 200" width="100%" height="auto" preserveAspectRatio="xMidYMid meet">
    {label && <title>{label}</title>}
    {
      /* Level marker (top-left). Same calm voice as the outer dashed
        boundary on levels 2-4 — uses --c-boundary. */
    }
    <g class="d-boundary" font-style="italic" font-size="10" font-weight="100" opacity="0.7">
      <text x="8" y="16">Level {level} · {LEVEL_NAME[level]}</text>
    </g>

    {
      level === 1 && (
        <>
          <g class="d-shape" fill="none" stroke-width="1.2">
            {/* Users (left) — stick figure circle + lines */}
            <circle cx="40" cy="100" r="8" />
            <path d="M40 108 L 40 128 M 30 118 L 50 118 M 32 140 L 40 128 L 48 140" />
            {/* Central system */}
            <rect x="120" y="70" width="80" height="60" rx="6" />
            {/* Connections */}
            <line x1="56" y1="100" x2="120" y2="100" />
            <line x1="200" y1="100" x2="240" y2="100" />
          </g>
          {/* External system (right) — dashed, takes the boundary
              colour to mark it as "outside the focus". */}
          <g class="d-boundary" fill="none" stroke-width="1.2">
            <rect x="240" y="80" width="64" height="40" rx="4" stroke-dasharray="4 3" />
          </g>
          <g class="d-label" font-size="10" text-anchor="middle" stroke-width="0.2">
            <text x="160" y="104">
              System
            </text>
            <text x="272" y="105">
              External
            </text>
            <text x="40" y="160">
              User
            </text>
          </g>
        </>
      )
    }

    {
      level === 2 && (
        <>
          {/* Outer system boundary — dashed, calm. */}
          <g class="d-boundary" fill="none" stroke-width="1.2">
            <rect
              x="40"
              y="40"
              width="240"
              height="140"
              rx="6"
              stroke-dasharray="4 3"
              opacity="0.6"
            />
          </g>
          {/* Containers inside + connector lines. */}
          <g class="d-shape" fill="none" stroke-width="1.2">
            <rect x="60" y="60" width="80" height="40" rx="4" />
            <rect x="180" y="60" width="80" height="40" rx="4" />
            <rect x="120" y="120" width="80" height="36" rx="4" />
            <line x1="100" y1="100" x2="100" y2="138" />
            <line x1="100" y1="138" x2="120" y2="138" />
            <line x1="220" y1="100" x2="220" y2="138" />
            <line x1="220" y1="138" x2="200" y2="138" />
          </g>
          <g class="d-label" font-size="10" text-anchor="middle" stroke-width="0.2">
            <text x="100" y="83">
              Web app
            </text>
            <text x="220" y="83">
              API
            </text>
            <text x="160" y="141">
              Database
            </text>
          </g>
        </>
      )
    }

    {
      level === 3 && (
        <>
          <g class="d-boundary" fill="none" stroke-width="1.2">
            <rect
              x="45"
              y="40"
              width="240"
              height="140"
              rx="6"
              stroke-dasharray="4 3"
              opacity="0.6"
            />
          </g>
          <g class="d-shape" fill="none" stroke-width="1.2">
            <rect x="60" y="60" width="64" height="32" rx="4" />
            <rect x="140" y="60" width="64" height="32" rx="4" />
            <rect x="220" y="60" width="50" height="32" rx="4" />
            <rect x="60" y="120" width="64" height="32" rx="4" />
            <rect x="140" y="120" width="130" height="32" rx="4" />
            <line x1="92" y1="92" x2="92" y2="120" />
            <line x1="172" y1="92" x2="172" y2="120" />
            <line x1="245" y1="92" x2="245" y2="120" />
          </g>
          <g class="d-label" font-size="9" text-anchor="middle" stroke-width="0.2">
            <text x="92" y="80">
              Auth
            </text>
            <text x="172" y="80">
              Orders
            </text>
            <text x="245" y="80">
              Mail
            </text>
            <text x="92" y="139">
              Repo
            </text>
            <text x="205" y="139">
              Bus
            </text>
          </g>
        </>
      )
    }

    {
      level === 4 && (
        <>
          <g class="d-boundary" fill="none" stroke-width="1.2">
            <rect
              x="40"
              y="40"
              width="240"
              height="140"
              rx="6"
              stroke-dasharray="4 3"
              opacity="0.6"
            />
          </g>
          <g class="d-shape" fill="none" stroke-width="1.2">
            {/* Class boxes with header strips. */}
            <rect x="60" y="50" width="80" height="60" rx="2" />
            <line x1="60" y1="64" x2="140" y2="64" />
            <rect x="180" y="50" width="80" height="60" rx="2" />
            <line x1="180" y1="64" x2="260" y2="64" />
            <rect x="120" y="130" width="80" height="34" rx="2" />
            <line x1="120" y1="144" x2="200" y2="144" />
            <line x1="140" y1="80" x2="180" y2="80" />
            <line x1="100" y1="110" x2="100" y2="150" />
            <line x1="100" y1="150" x2="120" y2="150" />
            <line x1="220" y1="110" x2="220" y2="150" />
            <line x1="220" y1="150" x2="200" y2="150" />
          </g>
          <g class="d-label" font-size="9" text-anchor="middle" stroke-width="0.2">
            <text x="100" y="61">
              OrderService
            </text>
            <text x="220" y="61">
              OrderRepo
            </text>
            <text x="160" y="141">
              OrderEvent
            </text>
          </g>
        </>
      )
    }
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
