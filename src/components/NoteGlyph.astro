---
// Inline decorative SVG glyphs for the note left-rail.
// The enum mirrors the `notes` collection schema in `src/content.config.ts`.
// The wrapping `<div class="note-glyph g-${kind}">` carries the colour via
// `.note-glyph.g-{kind}` rules in base.css; the SVG itself uses
// `currentColor` so it follows the wrapper's colour.

export type NoteGlyphKind = 'garden' | 'code' | 'guitar' | 'coffee' | 'none';

export interface Props {
  kind: NoteGlyphKind;
}

const { kind } = Astro.props;
---

{
  kind !== 'none' && (
    <div class={`note-glyph g-${kind}`} aria-hidden="true">
      {kind === 'code' && (
        <svg viewBox="0 0 24 24" width="22" height="22">
          <g
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 7 L 4 12 L 9 17" />
            <path d="M15 7 L 20 12 L 15 17" />
          </g>
        </svg>
      )}
      {kind === 'guitar' && (
        <svg viewBox="0 0 24 24" width="22" height="22">
          <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <circle cx="14" cy="16" r="6" />
            <path d="M14 16 L 18 12 L 22 8" />
            <path d="M16 6 L 20 10" />
          </g>
        </svg>
      )}
      {kind === 'garden' && (
        <svg viewBox="0 0 24 24" width="22" height="22">
          <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <path d="M12 21 L 12 10" />
            <path d="M12 14 q -5 -3 -7 0 q 2 4 7 2" />
            <path d="M12 10 q 5 -3 7 0 q -2 4 -7 2" />
          </g>
        </svg>
      )}
      {kind === 'coffee' && (
        <svg viewBox="0 0 24 24" width="22" height="22">
          <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <path d="M5 11 L 6 19 L 16 19 L 17 11 Z" />
            <path d="M17 12 q 3 0 3 3 q 0 3 -3 3" />
            <path d="M9 8 q 0 -2 2 -2" />
          </g>
        </svg>
      )}
    </div>
  )
}
