---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

{
  /* Two slots:
    - **default** — `<FactsRow>` children only. Rendered inside a
      `<dl>`, so anything else (a bare `<p>`, an `<a>`) would fail
      html-validate's `element-permitted-content` rule.
    - **footer** — a single `<a class="facts-foot-link">` rendered as
      a sibling of the `<dl>`, used for "see more" links (e.g. the
      `full bench tour → /now` link in the about sidebar). Keep it to
      one anchor; multiple children would stack with no separator
      styling. */
}
<section class="facts-card">
  <h3 class="facts-title">{title}</h3>
  <dl>
    <slot />
  </dl>
  <slot name="footer" />
</section>
