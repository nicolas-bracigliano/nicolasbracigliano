---
// Home-page "currently on the bench" section: a grid of BenchCards plus
// its eyebrow + "full bench tour" link. Extracted from the two index
// pages (en/es) so the markup lives once and the locale strings sit in a
// copy object, mirroring the masthead components. The items are derived
// upstream by `benchItemsFrom` (src/lib/now-items.ts) from the teaser'd
// /now items — this component only renders. Renders nothing when there
// are no bench items, so the home page needs no separate guard.
import BenchCard from '@components/BenchCard.astro';
import type { BenchItem } from '@lib/now-items';
import { ROUTES, type Locale } from '@lib/routes';

export interface Props {
  items: readonly BenchItem[];
  locale: Locale;
}
const { items, locale } = Astro.props;

const copy = {
  en: { eyebrow: 'Currently on the bench', tour: 'full bench tour →', peek: 'see /now →' },
  es: {
    eyebrow: 'En el banco ahora',
    tour: 'tour completo del escritorio →',
    peek: 'ver /ahora →',
  },
} as const;
const t = copy[locale];
const nowHref = ROUTES.now[locale];
---

{
  items.length > 0 && (
    <section class="bench" aria-labelledby="bench-h">
      <header class="bench-head">
        <span class="eyebrow" id="bench-h">
          {t.eyebrow}
        </span>
        <a class="bench-tour-link" href={nowHref} data-astro-prefetch>
          {t.tour}
        </a>
      </header>
      <ul class="bench-grid">
        {items.map((b, i) => (
          <li>
            <BenchCard
              kind={b.kind}
              tag={`${String(i + 1).padStart(2, '0')} · ${b.label}`}
              title={b.title}
              line={b.line}
              seedlingTag={b.seedlingTag}
              guitarLabel={b.guitarLabel}
              href={nowHref}
              peekLabel={t.peek}
            />
          </li>
        ))}
      </ul>
    </section>
  )
}
