---
// Margin note for the /notes route. Rendered in the right rail next to
// the note's prose body; styled by `src/styles/routes/notes.css` via
// the `.margin-note` class.
//
// **Note for future-me:** the /pieces route used to use this component
// too, in a 3-column marginalia layout. Per ADR 0012, pieces pivoted to
// a single-column editorial article with inline pull quotes (`<p
// class="pull">`) injected directly by the `remark-inject-margin-notes`
// plugin from frontmatter. This component is now the /notes-only
// renderer; do NOT change its markup without re-checking notes.css.
export interface Props {
  text: string;
  mark?: string;
}
const { text, mark = '↳' } = Astro.props;
---

<div class="margin-note">
  <span class="margin-mark" aria-hidden="true">{mark}</span>
  <p>{text}</p>
</div>
