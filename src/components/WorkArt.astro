---
// Decorative vignette art for a work. Two-level dispatch:
//
//   1. `kind` carries the colour theme via the wrapper class
//      `.work-art--${kind}` (terminal-bg + terminal-fg for code,
//      accent tint for music, mate tint for garden, ink-blue for print).
//   2. `art` (optional) picks which inner SVG/`<pre>` renders. If unset,
//      we fall back to the kind-default — every code work shows
//      `terminal`, every print shows `tray`, etc. To give a work its own
//      vignette without breaking other works of the same kind, set
//      `art:` in the frontmatter to one of the menu values below.
//
// Adding a new variant: extend `WorkArtVariant` here AND the matching
// `art` enum in `src/content.config.ts`, then add a `{variant === '...'}`
// block below. The kind→default map only needs updating if the new
// variant is intended to be a kind's *default*.

export type WorkKind = 'code' | 'print' | 'music' | 'garden';

// prettier-ignore — keep this on one line. Astro's esbuild loader (as
// of 0.27.x) refuses to parse the multi-line `| 'foo' | 'bar'` shape
// inside `.astro` frontmatter, surfacing as "Unexpected `|`" at build
// time. The single-line form parses fine.
// prettier-ignore
export type WorkArtVariant = 'terminal' | 'font-specimen' | 'tray' | 'capo' | 'knob' | 'waveform' | 'garden-plot';

export interface Props {
  kind: WorkKind;
  art?: WorkArtVariant;
}

const { kind, art } = Astro.props;

const DEFAULT_ART_FOR_KIND: Record<WorkKind, WorkArtVariant> = {
  code: 'terminal',
  print: 'tray',
  music: 'waveform',
  garden: 'garden-plot',
};
const variant: WorkArtVariant = art ?? DEFAULT_ART_FOR_KIND[kind];
---

<div class={`work-art work-art--${kind}`} data-art={variant} aria-hidden="true">
  {
    variant === 'terminal' && (
      <pre class="work-art-terminal">{`$ build   ──────────────╮
  ✓ scaffolded site     │
  ✓ /content             │
  ✓ /public              │
  ✓ feed.xml             │
  ── ready ──────────────╯`}</pre>
    )
  }
  {
    variant === 'font-specimen' && (
      <div class="work-art-type">
        <span class="work-art-type-big">Aa</span>
        <span class="work-art-type-list">
          <em>aábcdeéfghi…</em>
          <br />
          <em>012 / 345 / 6+7</em>
          <br />
          <span class="muted">Newsreader · 32 / 14</span>
        </span>
      </div>
    )
  }
  {
    variant === 'tray' && (
      <svg viewBox="0 0 200 140" width="100%" height="100%">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <path d="M30,40 L170,40 L160,110 L40,110 Z" />
          <path d="M30,40 L170,40" />
          <path d="M50,60 L150,60 L145,95 L55,95 Z" opacity="0.6" />
          <path d="M50,60 L60,52 L150,52 L150,60" opacity="0.5" />
          <line x1="100" x2="100" y1="60" y2="95" opacity="0.5" />
          <line x1="80" x2="80" y1="60" y2="80" opacity="0.5" />
          <line x1="30" x2="170" y1="124" y2="124" stroke-dasharray="2 2" opacity="0.4" />
        </g>
      </svg>
    )
  }
  {
    variant === 'capo' && (
      <svg viewBox="0 0 200 140" width="100%" height="100%">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <path d="M40,60 q 60 -40 120 0 q -10 8 -60 8 q -50 0 -60 -8 Z" />
          <rect x="86" y="74" width="28" height="44" rx="2" />
          <line x1="100" x2="100" y1="82" y2="112" opacity="0.4" />
          <circle cx="100" cy="90" r="2" fill="currentColor" stroke="none" />
        </g>
      </svg>
    )
  }
  {
    variant === 'knob' && (
      <svg viewBox="0 0 200 140" width="100%" height="100%">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <circle cx="100" cy="70" r="44" />
          <circle cx="100" cy="70" r="36" opacity="0.4" />
          <line x1="100" x2="100" y1="70" y2="34" />
          {Array.from({ length: 12 }).map((_, i) => {
            const a = (i / 12) * Math.PI * 2 - Math.PI / 2;
            const x1 = 100 + Math.cos(a) * 50;
            const y1 = 70 + Math.sin(a) * 50;
            const x2 = 100 + Math.cos(a) * 54;
            const y2 = 70 + Math.sin(a) * 54;
            return <line x1={x1} y1={y1} x2={x2} y2={y2} opacity="0.5" />;
          })}
        </g>
      </svg>
    )
  }
  {
    variant === 'waveform' && (
      <svg viewBox="0 0 200 140" width="100%" height="100%">
        <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
          {Array.from({ length: 40 }).map((_, i) => {
            // Deterministic pseudo-waveform — repeats run-to-run so the
            // visual snapshot stays stable.
            const h = 18 + Math.abs(Math.sin(i * 0.5)) * 36 + (i % 7) * 2;
            return <line x1={10 + i * 4.5} x2={10 + i * 4.5} y1={70 - h / 2} y2={70 + h / 2} />;
          })}
        </g>
      </svg>
    )
  }
  {
    variant === 'garden-plot' && (
      <svg viewBox="0 0 200 140" width="100%" height="100%">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <rect x="20" y="60" width="160" height="60" />
          {[1, 2, 3].map((i) => (
            <line x1={20 + i * 40} x2={20 + i * 40} y1="60" y2="120" opacity="0.3" />
          ))}
          <line x1="20" x2="180" y1="90" y2="90" opacity="0.3" />
          <circle cx="40" cy="75" r="3" fill="currentColor" stroke="none" />
          <circle cx="80" cy="75" r="3" fill="currentColor" stroke="none" />
          <circle cx="160" cy="105" r="3" fill="currentColor" stroke="none" />
        </g>
      </svg>
    )
  }
</div>
