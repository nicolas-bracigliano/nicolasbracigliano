---
// Decorative vignette art per work-kind. The wrapper class
// `.work-art.work-art--${kind}` carries the colour theme (terminal-bg
// for code, accent tint for music, mate tint for garden, ink-blue for
// print); the SVG strokes use `currentColor` to follow it.

export type WorkKind = 'code' | 'print' | 'music' | 'garden';

export interface Props {
  kind: WorkKind;
}
const { kind } = Astro.props;
---

<div class={`work-art work-art--${kind}`} aria-hidden="true">
  {
    kind === 'code' && (
      <pre class="work-art-terminal">{`$ ssg new   ─────────────╮
  ✓ scaffolded site      │
  ✓ /content             │
  ✓ /public              │
  ✓ atom.xml feed        │
  ── ready in 12ms ──────╯`}</pre>
    )
  }
  {
    kind === 'print' && (
      <svg viewBox="0 0 200 140" width="100%" height="100%">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <path d="M30,40 L170,40 L160,110 L40,110 Z" />
          <path d="M30,40 L170,40" />
          <path d="M50,60 L150,60 L145,95 L55,95 Z" opacity="0.6" />
          <path d="M50,60 L60,52 L150,52 L150,60" opacity="0.5" />
          <line x1="100" x2="100" y1="60" y2="95" opacity="0.5" />
          <line x1="80" x2="80" y1="60" y2="80" opacity="0.5" />
          <line x1="30" x2="170" y1="124" y2="124" stroke-dasharray="2 2" opacity="0.4" />
          <text
            x="100"
            y="134"
            text-anchor="middle"
            font-size="8"
            fill="currentColor"
            opacity="0.7"
          >
            142 mm
          </text>
        </g>
      </svg>
    )
  }
  {
    kind === 'music' && (
      <svg viewBox="0 0 200 140" width="100%" height="100%">
        <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
          {Array.from({ length: 40 }).map((_, i) => {
            // Deterministic pseudo-waveform — repeats run-to-run so the
            // visual snapshot stays stable.
            const h = 18 + Math.abs(Math.sin(i * 0.5)) * 36 + (i % 7) * 2;
            return <line x1={10 + i * 4.5} x2={10 + i * 4.5} y1={70 - h / 2} y2={70 + h / 2} />;
          })}
        </g>
        <text x="100" y="124" text-anchor="middle" font-size="9" fill="currentColor" opacity="0.6">
          milonga.wav · 02:14
        </text>
      </svg>
    )
  }
  {
    kind === 'garden' && (
      <svg viewBox="0 0 200 140" width="100%" height="100%">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <rect x="20" y="60" width="160" height="60" />
          {[1, 2, 3].map((i) => (
            <line x1={20 + i * 40} x2={20 + i * 40} y1="60" y2="120" opacity="0.3" />
          ))}
          <line x1="20" x2="180" y1="90" y2="90" opacity="0.3" />
          <circle cx="40" cy="75" r="3" fill="currentColor" stroke="none" />
          <circle cx="80" cy="75" r="3" fill="currentColor" stroke="none" />
          <circle cx="160" cy="105" r="3" fill="currentColor" stroke="none" />
          <text x="40" y="58" font-size="7" text-anchor="middle" fill="currentColor">
            tom
          </text>
          <text x="80" y="58" font-size="7" text-anchor="middle" fill="currentColor">
            bsl
          </text>
          <text x="120" y="58" font-size="7" text-anchor="middle" fill="currentColor">
            cmf
          </text>
          <text x="160" y="58" font-size="7" text-anchor="middle" fill="currentColor">
            chl
          </text>
        </g>
      </svg>
    )
  }
</div>
