---
import type { Locale } from '@lib/routes';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Notes',
    h1Lead: 'Bitacora —',
    h1Italic: 'scribbled in public.',
    sub: "Short entries: things I learned, things I'm wondering about, small wins and small confusions. No polish promised.",
  },
  es: {
    eyebrow: 'Notas',
    h1Lead: 'Bitacora —',
    h1Italic: 'garabateado en público.',
    sub: 'Entradas cortas: cosas que aprendí, cosas que me intrigan, pequeñas victorias y pequeñas dudas. Nada pulido, lo prometo.',
  },
} as const;

const t = copy[locale];
---

<header class="notes-head">
  <span class="eyebrow eyebrow--rule">{t.eyebrow}</span>
  <h1 class="notes-h1">
    {t.h1Lead}
    <br />
    <span class="serif-italic">{t.h1Italic}</span>
  </h1>
  <p class="notes-sub">{t.sub}</p>
</header>
