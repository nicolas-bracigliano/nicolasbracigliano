---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@lib/routes';

export interface Props {
  entries: readonly CollectionEntry<'works'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;

import { WORK_KINDS, type WorkKind } from '@lib/content-kinds';

const counts: Record<WorkKind | 'all', number> = {
  all: entries.length,
  code: 0,
  print: 0,
  guitar: 0,
  garden: 0,
};
for (const e of entries) counts[e.data.kind] += 1;

// Filter labels are user-facing copy, intentionally decoupled from the
// internal kind taxonomy: `kind: 'guitar'` is the schema's stable id
// (aligned with bench/now), but the chip reads "music" because the
// works page is about the medium, not the instrument.
const labels = {
  en: { all: 'everything', code: 'code', print: '3D prints', guitar: 'music', garden: 'garden' },
  es: {
    all: 'todo',
    code: 'código',
    print: 'impresiones 3D',
    guitar: 'música',
    garden: 'huerta',
  },
} as const;

const t = labels[locale];
const buttons: { key: WorkKind | 'all'; label: string }[] = [
  { key: 'all', label: t.all },
  ...WORK_KINDS.map((k) => ({ key: k, label: t[k] })),
];

const ariaLabel = locale === 'es' ? 'Filtros' : 'Filters';
---

{
  /* Filters are show/hide toggles, not tabs (no separate panels), so
    `<button aria-pressed>` inside a `<div role="toolbar">` is the right
    semantic — not the prototype's `<nav role="tablist">` mixed pattern.
    Tap-area vs visible-chip split mirrors the chrome lang-toggle: the
    outer `<button>` is the 44 px WCAG 2.5.5 floor with no visible
    border; the inner `.filter-chip` keeps the prototype's tight pill. */
}
<div class="works-filters" role="toolbar" aria-label={ariaLabel}>
  {
    buttons.map((b, i) => (
      <button
        type="button"
        class={`filter${i === 0 ? ' on' : ''}`}
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-filter={b.key}
      >
        <span class="filter-chip">
          <span class="filter-key">{b.key}</span>
          <span class="filter-label">{b.label}</span>
          <span class="filter-count">{counts[b.key]}</span>
        </span>
      </button>
    ))
  }
</div>

<script>
  // ~600 B minified. Click delegation on the toolbar: set the
  // `data-active-filter` on the grid, mirror `.on` + `aria-pressed` on
  // every button, then walk the grid items and toggle `hidden` by
  // matching `data-kind`.
  //
  // `astro:page-load` fires on every ClientRouter navigation, so without
  // a guard each visit to `/works/` would stack another click listener.
  // The `data-wired` attribute marks an instance as already attached.
  function wireFilters(): void {
    const nav = document.querySelector<HTMLElement>('.works-filters');
    const grid = document.querySelector<HTMLElement>('.works-grid');
    if (!nav || !grid || nav.dataset['wired'] === 'true') return;
    nav.dataset['wired'] = 'true';

    nav.addEventListener('click', (event) => {
      const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('.filter');
      if (!btn) return;
      const filter = btn.dataset['filter'] ?? 'all';
      grid.dataset['activeFilter'] = filter;
      nav.querySelectorAll<HTMLButtonElement>('.filter').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      grid.querySelectorAll<HTMLElement>('.work-card').forEach((card) => {
        const kind = card.dataset['kind'] ?? '';
        card.hidden = filter !== 'all' && kind !== filter;
      });
    });
  }
  document.addEventListener('astro:page-load', wireFilters);
</script>
