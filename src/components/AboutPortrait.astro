---
import type { Locale } from '@lib/routes';
import Portrait from '@components/Portrait.astro';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const caption = locale === 'es' ? 'un autorretrato, más o menos' : 'a self-portrait, more or less';
const title =
  locale === 'es'
    ? 'Un autorretrato en linograbado, con un mate en la mano'
    : 'A linocut self-portrait, holding a mate gourd';
---

<figure class="about-portrait">
  <Portrait class="about-portrait-art" decorative={false} title={title} />
  <figcaption class="about-portrait-caption serif-italic">{caption}</figcaption>
</figure>
