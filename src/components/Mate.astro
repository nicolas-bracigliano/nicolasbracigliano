---
// Inline mate vignette — the gourd-and-bombilla icon used in the
// masthead bio and Field Notes. Decorative SVG + optional visible
// label; no aria-label on the wrapper (per axe-core's
// aria-prohibited-attr rule — span has no role that supports
// accessible names).

export interface Props {
  /** Optional label after the icon. Defaults to "mate". */
  label?: string;
}

const { label = 'mate' } = Astro.props;
---

<span class="inline-vignette vignette--mate">
  <svg viewBox="10 5 145 205" width="16" height="20" aria-hidden="true" class="icon-mate">
    <g
      fill="none"
      stroke="currentColor"
      stroke-width="6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <!-- Straw -->
      <path d="M92 85 C106 55, 123 27, 148 10"></path>

      <!-- Straw bead -->
      <circle cx="114" cy="43" r="6"></circle>

      <!-- Top rim — open trapezoid sitting on the body's top edge -->
      <path d="M45 87 H112 L124 106 H32 Z"></path>

      <!-- Gourd body — closed curve. Its `Z` segment is the shared
           top edge with the rim, so when both are outlined we read
           "rim resting on body" without needing a fill or cut line. -->
      <path
        d="
        M31 111
        C22 127, 16 143, 17 159
        C19 192, 41 205, 75 205
        C110 205, 132 192, 135 160
        C137 143, 131 127, 122 111
        Z
      "
      ></path>
    </g>
  </svg>

  {label && <span class="vignette-label">{label}</span>}
</span>
