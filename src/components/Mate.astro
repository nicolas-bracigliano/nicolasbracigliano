---
// Inline mate vignette — the gourd-and-bombilla icon used in the
// masthead bio and Field Notes. Decorative SVG + optional visible
// label; no aria-label on the wrapper (per axe-core's
// aria-prohibited-attr rule — span has no role that supports
// accessible names).

export interface Props {
  /** Optional label after the icon. Defaults to "mate". */
  label?: string;
}

const { label = 'mate' } = Astro.props;
---

<span class="inline-vignette vignette--mate">
  <svg viewBox="0 0 30 30" width="20" height="20" aria-hidden="true" class="icon-mate">
    <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <ellipse cx="15" cy="18" rx="8" ry="9"></ellipse>
      <path d="M19 9 L 24 4"></path>
      <path d="M22 7 L 26 7"></path>
      <path d="M9 14 L 21 14"></path>
    </g>
  </svg>
  {label && <span class="vignette-label">{label}</span>}
</span>
