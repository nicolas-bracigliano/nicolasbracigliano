---
// PieceEntry — long-form sibling of NoteEntry. Renders in two modes:
//
//   - **Standalone** (slug page, `isStandalone=true`): full prose body,
//     diagram rails top + bottom, foot with read-time. The piece title
//     becomes the page's `<h1>`.
//
//   - **Index** (list view, `isStandalone=false` default): a card-style
//     excerpt — title + lede + first paragraphs of the body + a
//     "continue reading" link. NO diagrams, NO body slot beyond the
//     excerpt. Keeps the index lightweight and the reader oriented;
//     full content lives one click away.
//
// Margin notes are NOT rendered here in either mode. The
// `remark-inject-margin-notes` plugin (wired in `astro.config.ts`)
// injects them into the markdown AST right after their anchor heading
// at build time — they only show up on the slug page, and the index
// excerpt cuts off before any of them would appear (the kernel is
// the prose before the first H2, where margin notes live).
//
// On viewports ≤ 880 px, `.piece-left` (date + tags) hides via CSS
// and the same data renders inside `.piece-meta-foot` below the body.
// Two render locations, mutually exclusive via display: none, so the
// accessibility tree only sees one.
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@lib/routes';
import { entryRouteFor } from '@lib/i18n';
import { readingTimeMinutes } from '@lib/reading-time';
import DiagramRail from './DiagramRail.astro';

export interface Props {
  entry: CollectionEntry<'pieces'>;
  locale: Locale;
  /** Single-entry page (PieceLayout) vs index-list context. When true,
   *  the foot's permalink is suppressed and the full body slot renders. */
  isStandalone?: boolean;
}

const { entry, locale, isStandalone = false } = Astro.props;
const { date, tags, title, lede, diagrams, minutes: minutesOverride } = entry.data;
const permalink = entryRouteFor(entry);
const minutes = minutesOverride ?? (entry.body ? readingTimeMinutes(entry.body) : null);

// Diagram placement modes per the P2 review fix (top / bottom / after).
// `after` is reserved; if any piece sets it before the inline-rehype
// plugin lands, fail loudly at build time rather than silently render
// in the wrong position.
const inlineDiagrams = diagrams.filter((d) => d.after !== undefined);
if (inlineDiagrams.length > 0) {
  const keys = inlineDiagrams.map((d) => `${d.key}(after:${d.after})`).join(', ');
  throw new Error(
    `[PieceEntry] inline diagram placement (\`after: ...\`) is not yet ` +
      `implemented. Piece "${title}" uses it for: ${keys}. ` +
      `Either remove \`after\` and use \`place: 'top' | 'bottom'\`, ` +
      `or implement the rehype-inject-diagrams plugin and remove this ` +
      `guard. (See \`src/lib/diagram-registry.ts\` for the placement-mode ` +
      `comment block.)`,
  );
}
const topDiagrams = diagrams.filter((d) => d.place !== 'bottom');
const bottomDiagrams = diagrams.filter((d) => d.place === 'bottom');

const dateFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-AR' : 'en-AU', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const dateParts = dateFormatter.formatToParts(date).filter((p) => p.type !== 'literal');
const dateDisplay = `${dateParts.find((p) => p.type === 'year')?.value} · ${dateParts.find((p) => p.type === 'month')?.value} · ${dateParts.find((p) => p.type === 'day')?.value}`;

const readTimeLabel = locale === 'es' ? 'lectura' : 'read time';
const minLabel = locale === 'es' ? 'min' : 'min';
const continueLabel = locale === 'es' ? 'seguir leyendo →' : 'continue reading →';

// On the index, the piece body shows only its KERNEL — the prose
// before the first `## ` heading, capped at three paragraphs. Kernels
// are deliberately written as plain prose (no inline markdown, no
// lists, no code blocks), so they render safely as escaped-text
// paragraphs without a markdown processor. The cap also protects
// against future pieces that don't use H2 headings — they'd otherwise
// dump their whole body into the index.
const EXCERPT_PARAGRAPH_CAP = 3;
const kernelParagraphs: string[] = !isStandalone
  ? ((entry.body ?? '')
      .split('\n## ')[0]
      ?.trim()
      .split(/\n\n+/)
      .filter((p) => p.length > 0)
      .slice(0, EXCERPT_PARAGRAPH_CAP) ?? [])
  : [];

const TitleTag = isStandalone ? 'h1' : 'h3';
---

<li class="piece">
  <div class="piece-left">
    <div class="piece-date">{dateDisplay}</div>
    {
      tags && tags.length > 0 && (
        <div class="piece-tags">
          {tags.map((t) => (
            <span class="piece-tag">#{t}</span>
          ))}
        </div>
      )
    }
  </div>

  <article class="piece-body">
    <TitleTag class="piece-title">
      <a href={permalink} data-astro-prefetch>{title}</a>
    </TitleTag>
    {lede && <p class="piece-lede">{lede}</p>}

    {/* Standalone — full prose + diagrams. */}
    {
      isStandalone && (
        <>
          {topDiagrams.length > 0 && <DiagramRail items={topDiagrams} />}
          <div class="piece-prose">
            <slot />
          </div>
          {bottomDiagrams.length > 0 && <DiagramRail items={bottomDiagrams} />}
        </>
      )
    }

    {
      /* Index excerpt — kernel paragraphs + continue-reading link.
        Diagrams + margin notes do not render in this mode; they
        belong with the full piece. */
    }
    {
      !isStandalone && kernelParagraphs.length > 0 && (
        <div class="piece-prose piece-prose--excerpt">
          {kernelParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      )
    }

    {
      /* Mobile-only meta strip — date + tags moved here under ≤ 880 px,
        where `.piece-left` is hidden. Renders on every breakpoint but
        is `display: none` on desktop; accessibility tree shows only
        one location at a time. */
    }
    <div class="piece-meta-foot">
      <span class="piece-date">{dateDisplay}</span>
      {
        tags && tags.length > 0 && (
          <span class="piece-tags-inline">
            {tags.map((t) => (
              <span class="piece-tag">#{t}</span>
            ))}
          </span>
        )
      }
    </div>

    {
      (minutes !== null || !isStandalone) && (
        <div class="piece-foot">
          {minutes !== null && (
            <span>
              {readTimeLabel} · {minutes} {minLabel}
            </span>
          )}
          {minutes !== null && !isStandalone && <span class="sep">·</span>}
          {!isStandalone && (
            <a class="piece-continue" href={permalink}>
              {continueLabel}
              <span class="visually-hidden">: {title}</span>
            </a>
          )}
        </div>
      )
    }
  </article>
</li>
