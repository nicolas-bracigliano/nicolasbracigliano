---
// PieceEntry — index-row component. Renders one piece as a row in the
// `/en/pieces/` and `/es/ensayos/` index lists. Per ADR 0012 the slug
// page is owned directly by `PieceLayout.astro`; this component used to
// double as the standalone-page renderer and no longer does.
//
// Structure (desktop):
//   <li class="piece-row">
//     <a class="piece-row-link" href={permalink}>
//       <div class="piece-row-meta">date / read-time / tags</div>
//       <div class="piece-row-body">
//         <h2 class="piece-row-title"><em>title</em></h2>
//         <p class="piece-row-deck">{lede}</p>
//       </div>
//     </a>
//   </li>
//
// Mobile (≤720px): the grid collapses to a single column; meta flows
// horizontally above the title row.
//
// Tags render only here, not on the slug page (PR P5 decision 8).
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@lib/routes';
import { entryRouteFor } from '@lib/i18n';
import { readingTimeMinutes } from '@lib/reading-time';

export interface Props {
  entry: CollectionEntry<'pieces'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { date, tags, title, lede, minutes: minutesOverride } = entry.data;
const permalink = entryRouteFor(entry);
const minutes = minutesOverride ?? (entry.body ? readingTimeMinutes(entry.body) : null);

const copy = {
  en: { minLabel: 'min' },
  es: { minLabel: 'min' },
} as const;
const t = copy[locale];

const dateFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-AR' : 'en-AU', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Australia/Melbourne',
});
const dateParts = dateFormatter.formatToParts(date).filter((p) => p.type !== 'literal');
const dateDisplay = [
  dateParts.find((p) => p.type === 'year')?.value,
  dateParts.find((p) => p.type === 'month')?.value,
  dateParts.find((p) => p.type === 'day')?.value,
]
  .filter(Boolean)
  .join(' · ');

// Same inline-italic convention as PieceLayout — `_word_` in the title
// becomes `<em>word</em>` so split-style titles ("The case for the
// _small static site_") render as the author intended on the index too.
function renderTitle(raw: string): string {
  return raw.replace(/_([^_]+)_/g, '<em>$1</em>');
}
const titleHtml = renderTitle(title);
---

<li class="piece-row">
  <a class="piece-row-link" href={permalink} data-astro-prefetch>
    <div class="piece-row-meta">
      <time class="piece-row-date" datetime={date.toISOString().split('T')[0]}>{dateDisplay}</time>
      {
        minutes !== null && (
          <span class="piece-row-time">
            {minutes} {t.minLabel}
          </span>
        )
      }
    </div>

    <div class="piece-row-body">
      <h2 class="piece-row-title"><Fragment set:html={titleHtml} /></h2>
      {lede && <p class="piece-row-deck">{lede}</p>}
      {
        tags && tags.length > 0 && (
          <p class="piece-row-tags">
            {tags.map((tag) => (
              <span class="piece-row-tag">#{tag}</span>
            ))}
          </p>
        )
      }
    </div>

    <span class="piece-row-arrow" aria-hidden="true">→</span>
  </a>
</li>
