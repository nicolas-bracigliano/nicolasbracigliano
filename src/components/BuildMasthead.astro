---
import type { Locale } from '@lib/routes';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Build notes',
    h1Lead: 'What this site',
    h1Italic: 'is made of.',
    sub: 'The stack, type, hosting, workflow, and principles behind the site. Updated whenever the build changes.',
  },
  es: {
    eyebrow: 'Cómo está hecho',
    h1Lead: 'De qué está hecho',
    h1Italic: 'este sitio.',
    sub: 'El stack, las tipografías, el hosting, el flujo de trabajo y los principios detrás del sitio. Se actualiza cada vez que cambia el build.',
  },
} as const;

const t = copy[locale];
---

<header class="build-head">
  <span class="eyebrow eyebrow--rule">{t.eyebrow}</span>
  <h1 class="build-h1">
    {t.h1Lead}
    <br />
    <span class="serif-italic">{t.h1Italic}</span>
  </h1>
  <p class="build-sub">{t.sub}</p>
</header>
