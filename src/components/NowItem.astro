---
// One row of the numbered bench tour. Two-column grid: the
// monospaced № on the left, the body (where / title / prose /
// detail <dl>) on the right. The `kind` prop becomes a class on the
// `<li>` (`.now-code`, `.now-garden`, …) which paints the № in a
// kind-appropriate hue without splitting the rest of the row's
// styling per kind.
//
// Item shape and kind enum live in `src/lib/now-items.ts` as a Zod
// schema + inferred TS types — single source of truth shared with
// `src/content.config.ts`'s `pages` collection so the frontmatter
// validator and the component prop types can't drift.

import type { NowPageItem } from '@lib/now-items';
// Re-exported for callers that already import these names from
// this component. Future callers should import directly from
// `@lib/now-items`; these re-exports exist for backward compat.
export type { NowItemKind, NowItemDetailRow, NowPageItem } from '@lib/now-items';

export interface Props extends NowPageItem {
  /** 1-based ordinal — `1` becomes "№ 01". Named `position` rather
   *  than `index` so a future caller doesn't pass an array index by
   *  reflex and silently shift every row down by one. */
  position: number;
}

const { position, kind, where, title, prose, detail } = Astro.props;

// `№ 01`, `№ 02`, …. Tabular-nums in CSS keeps the rail straight even
// once the list crosses ten items.
const num = `№ ${String(position).padStart(2, '0')}`;
---

<li class={`now-item now-${kind}`}>
  <div class="now-num">{num}</div>
  <div class="now-body">
    <span class="now-where">{where}</span>
    {
      /* h2, not h3 — each item is a sibling-level section to the
        masthead h1's intro, with no intermediate level. The
        prototype skipped from h1 to h3; we don't inherit that. */
    }
    <h2 class="now-title">{title}</h2>
    <p class="now-prose">{prose}</p>
    <dl class="now-detail">
      {
        detail.map((row) => (
          <>
            <dt>{row.dt}</dt>
            <dd>{row.dd}</dd>
          </>
        ))
      }
    </dl>
  </div>
</li>
