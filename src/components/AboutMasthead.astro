---
import type { Locale } from '@lib/routes';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = {
  en: {
    eyebrow: 'About',
    h1Italic: 'Hola',
    h1Rest: "I'm Nicolas.",
    lede: "Twenty years, give or take, of software engineering. I've always cared more about the inside of a system than its surface: how it really works, and whether it's honest about it. That pull runs from a first computer at seven to the security software I build now.",
  },
  es: {
    eyebrow: 'Sobre',
    h1Italic: 'Hola',
    h1Rest: 'Soy Nicolás.',
    lede: 'Veinte años, más o menos, de ingeniería de software. Siempre me importó más lo que hay debajo de un sistema que su superficie: cómo funciona de verdad y si es honesto al respecto. Ese hilo va desde una primera computadora a los siete hasta el software de seguridad que construyo hoy.',
  },
} as const;

const t = copy[locale];
---

<header class="about-head">
  <span class="eyebrow eyebrow--rule">{t.eyebrow}</span>
  <h1 class="about-h1">
    {
      /* `Hola.` — the dot is its own span so it can carry `--accent`
        and visually rhyme with the intro's `.about-intro-dot` (the
        word the intro overlay dissolves IS this exact phrase, with
        the same coloured punctuation). */
    }
    <span class="serif-italic">{t.h1Italic}<span class="about-h1-dot">.</span></span>
    <br />
    {t.h1Rest}
  </h1>
  <p class="about-lede">{t.lede}</p>
</header>
