---
// Home-page "currently on the bench" vignette card (design system §3 + §11).
// One per craft. Each card is a clickable entry point to /now — the cards
// are doors into the same "what's on the bench" page. The whole card is a
// stretched link (`.bench-card-link::before { inset: 0 }`, the same pattern
// as WorkCard): the <a> wraps only the title for a meaningful accessible
// name, while a "see /now →" peek pill + accent dot are revealed on
// hover/focus.
//
// Art: each kind's vignette is a SINGLE shared component under
// `art/vignettes/<Kind>.astro` (ADR 0013 amendment, 2026-06). The works
// registry renders it stateless via ContentArt; the bench renders the same
// file with a `-vig` class (which scopes the scroll-in animation in
// animations.css) and, where the kind has one, a caption prop. One source
// per kind means the two surfaces can't drift.
//
// `garden` is the deliberate exception: a catalogued garden *work* shows a
// planted plot (`art/vignettes/Garden.astro`), while the bench shows a
// live, growing seedling — different metaphors for "shipped" vs "on the
// bench now" — so the seedling stays inline here with its `seedlingTag`.

// Kind union is owned by `src/lib/content-kinds.ts` (the same source the
// content schema validates against) so the component and the frontmatter
// can't drift on the set of kinds.
import type { BenchKind } from '@lib/content-kinds';
import CodeVignette from './art/vignettes/Code.astro';
import GuitarVignette from './art/vignettes/Guitar.astro';
import PrintVignette from './art/vignettes/Print.astro';
import HomeVignette from './art/vignettes/Home.astro';

export interface Props {
  kind: BenchKind;
  /** Eyebrow tag — e.g. "01 · code" / "01 · código". The number is
   *  derived from bench position by the home page; this is the final
   *  formatted string. */
  tag: string;
  /** Headline of the bench item, set in serif. */
  title: string;
  /** Descriptive prose underneath. */
  line: string;
  /** Caption baked into the seedling vignette ("tomate" / "tomato").
   *  Required for `kind: 'garden'` by the content schema; `| undefined`
   *  because the home page maps every bench item through one call site
   *  and TS can't correlate kind → caption presence (the schema does). */
  seedlingTag?: string | undefined;
  /** Caption baked into the guitar vignette (mode + piece + bar).
   *  Required for `kind: 'guitar'` by the content schema; `| undefined`
   *  for the same call-site reason as seedlingTag above. */
  guitarLabel?: string | undefined;
  /** Destination for the whole-card link — the localized /now route,
   *  passed in so this component stays locale-agnostic. */
  href: string;
  /** Hover/focus peek-pill label, e.g. "see /now →" / "ver /ahora →". */
  peekLabel: string;
}

// No fallback defaults: the captions are kind-conditionally required by
// the `teaser` refines in `nowItemSchema` (src/lib/now-items.ts), so an
// omission fails the build rather than silently injecting a wrong-locale
// string here.
const { kind, tag, title, line, seedlingTag, guitarLabel, href, peekLabel } = Astro.props;
---

<article class={`bench-card bench-card--${kind}`}>
  <div class="bench-card-art">
    {kind === 'code' && <CodeVignette class="code-vig" />}
    {kind === 'guitar' && <GuitarVignette class="guitar-vig" label={guitarLabel} />}
    {kind === 'print' && <PrintVignette class="print-vig" />}
    {kind === 'home' && <HomeVignette class="home-vig" />}

    {/* garden stays bespoke (a growing seedling, not the works plot) */}
    {
      kind === 'garden' && (
        <svg viewBox="0 0 200 140" class="seedling-vig" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
            <line x1="20" x2="180" y1="118" y2="118" stroke-dasharray="2 3" opacity="0.5" />
            <path class="stem" d="M100,118 C 100,90 100,70 100,50" />
            <path class="leaf l1" d="M100,84 q -22 -10 -28 -2 q 6 12 28 6" />
            <path class="leaf l2" d="M100,70 q 22 -10 28 -2 q -6 12 -28 6" />
            <path class="leaf l3" d="M100,56 q -18 -8 -22 0 q 4 10 22 4" />
            <rect x="120" y="100" width="42" height="14" rx="1" opacity="0.6" />
            <text
              x="141"
              y="110"
              text-anchor="middle"
              font-size="8"
              stroke="none"
              fill="currentColor"
            >
              {seedlingTag}
            </text>
          </g>
        </svg>
      )
    }
  </div>

  <div class="bench-card-text">
    <span class="bench-tag">{tag}</span>
    <h3 class="bench-title">
      <a class="bench-card-link" href={href} data-astro-prefetch>{title}</a>
    </h3>
    <p class="bench-line">{line}</p>
  </div>

  <span class="bench-card-peek" aria-hidden="true">{peekLabel}</span>
</article>
