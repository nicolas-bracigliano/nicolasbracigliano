---
// Home-page "currently on the bench" vignette card (design system §3 + §11).
// One per craft. Each card is a clickable entry point to /now — the four
// cards are four doors into the same "what's on the bench" page. The whole
// card is a stretched link (`.bench-card-link::before { inset: 0 }`, the
// same pattern as WorkCard): the <a> wraps only the title for a meaningful
// accessible name, while a "see /now →" peek pill + accent dot are revealed
// on hover/focus.
//
// Vignettes are inlined here (not extracted to separate component files)
// because they're tightly coupled — each one only exists inside its
// matching kind. The four together stay under ~150 LOC and tree-shake as
// one unit when the home page splits at build time.
//
// Deliberately NOT routed through ContentArt / the per-kind registry
// (see docs/decisions/0013-per-entry-art.md). BenchCard SVGs bake
// per-instance captions into `<text>` (`guitarLabel`, `seedlingTag`),
// so they're not stateless per-kind defaults — refactoring them
// through the registry would force a leaky props-by-kind abstraction
// onto WorkCard / NoteEntry too. Keep the inline form here on purpose.

// Kind union is owned by `src/lib/content-kinds.ts` (the same source the
// content schema validates against) so the component and the frontmatter
// can't drift on the set of kinds.
import type { BenchKind } from '@lib/content-kinds';

export interface Props {
  kind: BenchKind;
  /** Eyebrow tag — e.g. "01 · code" / "01 · código". The number is
   *  derived from bench position by the home page; this is the final
   *  formatted string. */
  tag: string;
  /** Headline of the bench item, set in serif. */
  title: string;
  /** Descriptive prose underneath. */
  line: string;
  /** Caption baked into the seedling vignette ("tomate" / "tomato").
   *  Required for `kind: 'garden'` by the content schema; `| undefined`
   *  because the home page maps every bench item through one call site
   *  and TS can't correlate kind → caption presence (the schema does). */
  seedlingTag?: string | undefined;
  /** Caption baked into the guitar vignette (mode + piece + bar).
   *  Required for `kind: 'guitar'` by the content schema; `| undefined`
   *  for the same call-site reason as seedlingTag above. */
  guitarLabel?: string | undefined;
  /** Destination for the whole-card link — the localized /now route,
   *  passed in so this component stays locale-agnostic. */
  href: string;
  /** Hover/focus peek-pill label, e.g. "see /now →" / "ver /ahora →". */
  peekLabel: string;
}

// No fallback defaults: the captions are kind-conditionally required in
// `benchItemSchema`, so an omission fails the build rather than silently
// injecting a wrong-locale string here.
const { kind, tag, title, line, seedlingTag, guitarLabel, href, peekLabel } = Astro.props;
---

<article class={`bench-card bench-card--${kind}`}>
  <div class="bench-card-art">
    {
      kind === 'code' &&
        // prettier-ignore
        <pre class="terminal-vig" aria-hidden="true">{`$ pnpm build
  ├─ Indexed  2 languages
  ├─ Indexed  37 pages
  ├─ Indexed  3380 words
  ├─ Indexed  0 filters
  ├─ Indexed  0 sorts
  ╰─ Completed in 4.94s. ✓`}<span class="caret" /></pre>
    }

    {
      kind === 'guitar' && (
        <svg viewBox="0 0 220 140" class="guitar-vig" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <line class="string s0" x1="10" x2="210" y1="20" y2="20" />
            <line class="string s1" x1="10" x2="210" y1="36" y2="36" />
            <line class="string s2" x1="10" x2="210" y1="52" y2="52" />
            <line class="string s3" x1="10" x2="210" y1="68" y2="68" />
            <line class="string s4" x1="10" x2="210" y1="84" y2="84" />
            <line class="string s5" x1="10" x2="210" y1="100" y2="100" />
            <line x1="60" x2="60" y1="20" y2="100" stroke-width="4" opacity="0.5" />
            <line x1="110" x2="110" y1="20" y2="100" stroke-width="4" opacity="0.5" />
            <line x1="160" x2="160" y1="20" y2="100" stroke-width="4" opacity="0.5" />
            <circle cx="85" cy="36" r="4" fill="var(--accent)" stroke="none" />
            <circle cx="135" cy="68" r="4" fill="var(--accent)" stroke="none" />
            <circle cx="135" cy="84" r="4" fill="var(--accent)" stroke="none" />
          </g>
          <text x="10" y="134" fill="currentColor" font-size="9" opacity="0.6">
            {guitarLabel}
          </text>
        </svg>
      )
    }

    {
      kind === 'garden' && (
        <svg viewBox="0 0 200 140" class="seedling-vig" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
            <line x1="20" x2="180" y1="118" y2="118" stroke-dasharray="2 3" opacity="0.5" />
            <path class="stem" d="M100,118 C 100,90 100,70 100,50" />
            <path class="leaf l1" d="M100,84 q -22 -10 -28 -2 q 6 12 28 6" />
            <path class="leaf l2" d="M100,70 q 22 -10 28 -2 q -6 12 -28 6" />
            <path class="leaf l3" d="M100,56 q -18 -8 -22 0 q 4 10 22 4" />
            <rect x="120" y="100" width="42" height="14" rx="1" opacity="0.6" />
            <text
              x="141"
              y="110"
              text-anchor="middle"
              font-size="8"
              stroke="none"
              fill="currentColor"
            >
              {seedlingTag}
            </text>
          </g>
        </svg>
      )
    }

    {
      kind === 'print' && (
        <svg viewBox="0 0 200 140" class="print-vig" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <path d="M100,30 L 160,55 L 160,105 L 100,130 L 40,105 L 40,55 Z" />
            <path d="M100,30 L 100,80" />
            <path d="M40,55 L 100,80 L 160,55" />
            <line class="layer l0" x1="40" x2="100" y1="55" y2="80" opacity="0.35" />
            <line class="layer l1" x1="40" x2="100" y1="62" y2="87" opacity="0.31" />
            <line class="layer l2" x1="40" x2="100" y1="69" y2="94" opacity="0.27" />
            <line class="layer l3" x1="40" x2="100" y1="76" y2="101" opacity="0.23" />
            <line class="layer l4" x1="40" x2="100" y1="83" y2="108" opacity="0.19" />
            <line class="layer l5" x1="40" x2="100" y1="90" y2="115" opacity="0.15" />
            <line class="layer l6" x1="40" x2="100" y1="97" y2="122" opacity="0.11" />
            <line x1="100" x2="160" y1="80" y2="55" opacity="0.35" />
            <line x1="100" x2="160" y1="87" y2="62" opacity="0.31" />
            <line x1="100" x2="160" y1="94" y2="69" opacity="0.27" />
            <line x1="100" x2="160" y1="101" y2="76" opacity="0.23" />
            <line x1="100" x2="160" y1="108" y2="83" opacity="0.19" />
            <line x1="100" x2="160" y1="115" y2="90" opacity="0.15" />
            <line x1="100" x2="160" y1="122" y2="97" opacity="0.11" />
            <circle class="head" cx="100" cy="30" r="3" fill="var(--accent)" stroke="none" />
          </g>
        </svg>
      )
    }

    {
      kind === 'home' && (
        <svg viewBox="0 0 200 140" width="45%" height="45%">
          <g fill="none" stroke="currentColor" stroke-width="1">
            {/* crown molding */}
            <line x1="46" x2="154" y1="14" y2="14" />
            <line x1="46" x2="154" y1="17" y2="17" opacity="0.4" />

            {/* wall panel */}
            <path d="M52,17 L52,102 L148,102 L148,17" opacity="0.6" />

            {/* wall slats */}
            {Array.from({ length: 18 }).map((_, i) => (
              <line x1={58 + i * 5} x2={58 + i * 5} y1="18" y2="100" opacity="0.3" />
            ))}

            {/* tv */}
            <rect x="66" y="40" width="68" height="36" stroke-width="1.2" fill="currentColor" />

            {/* fireplace slot */}
            <rect x="60" y="91.5" width="80" height="9" />

            {/* flames */}
            {Array.from({ length: 12 }).map((_, i) => {
              const x = 65 + i * 6;
              const h = i % 2 === 0 ? 6 : 4;
              return <path d={`M${x},99 q 1,-${h} 2,0`} opacity="0.55" fill="var(--accent)" />;
            })}

            {/* speakers on the shelf */}
            <ellipse
              cx="42"
              cy="95"
              rx="3.5"
              ry="4.5"
              fill="currentColor"
              stroke="none"
              opacity="0.75"
            />
            <ellipse
              cx="158"
              cy="95"
              rx="3.5"
              ry="4.5"
              fill="currentColor"
              stroke="none"
              opacity="0.75"
            />

            {/* floating bench, rounded ends */}
            <rect x="22" y="102" width="156" height="20" rx="6" />
            <line x1="22" x2="178" y1="104" y2="104" opacity="0.5" stroke-width="3" />

            {/* bench slats */}
            {Array.from({ length: 28 }).map((_, i) => (
              <line x1={30 + i * 5.18} x2={30 + i * 5.18} y1="108" y2="120" opacity="0.3" />
            ))}

            {/* underglow */}
            <line x1="26" x2="174" y1="128" y2="128" stroke-dasharray="2 2" opacity="0.4" />
          </g>
        </svg>
      )
    }
  </div>

  <div class="bench-card-text">
    <span class="bench-tag">{tag}</span>
    <h3 class="bench-title">
      <a class="bench-card-link" href={href} data-astro-prefetch>{title}</a>
    </h3>
    <p class="bench-line">{line}</p>
  </div>

  <span class="bench-card-peek" aria-hidden="true">{peekLabel}</span>
</article>
