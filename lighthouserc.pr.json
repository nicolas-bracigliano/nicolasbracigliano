{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/packages/utils/src/lighthouserc-schema.json",
  "//": "PR-run Lighthouse config. The canonical full-coverage config is lighthouserc.json (16 URLs x 2 runs), used on main pushes + local `pnpm lhci`. This trims to one URL per LAYOUT (6 URLs) at the same 2 runs, so PR feedback stays fast (~2 min vs ~5) while median-of-2 keeps single-run timing noise from flaking the gate. The post-merge run on main catches per-content / per-locale regressions the PR set skips. The `assert` block MUST stay identical to lighthouserc.json — tests/unit/lighthouse-config-parity.test.ts enforces it.",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/en/",
        "http://localhost/en/notes/",
        "http://localhost/en/notes/hello/",
        "http://localhost/en/about/",
        "http://localhost/en/pieces/",
        "http://localhost/en/pieces/rings-i-keep-redrawing/"
      ],
      "numberOfRuns": 2,
      "settings": {
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/(en/pieces|es/ensayos)(/|$)",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],

            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 1800 }],

            "resource-summary:total:size": ["error", { "maxNumericValue": 90000 }],
            "resource-summary:document:size": ["error", { "maxNumericValue": 35000 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 14000 }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30000 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 120000 }],
            "resource-summary:image:size": ["error", { "maxNumericValue": 30000 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],

            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 1800 }],

            "resource-summary:total:size": ["error", { "maxNumericValue": 50000 }],
            "resource-summary:document:size": ["error", { "maxNumericValue": 20000 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 14000 }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30000 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 120000 }],
            "resource-summary:image:size": ["error", { "maxNumericValue": 200000 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
