/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  # HSTS is owned by the Cloudflare zone (SSL/TLS -> Edge Certificates),
  # which overrides this line on every response. This is kept only as a
  # fallback if the zone setting is ever disabled; keep max-age >= 1 year
  # so the `preload` directive stays valid. Do not assume this value is
  # what's served — check the zone.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

# Vite content-hashes every filename it emits here
# (`BaseLayout.DSiEMvyq.css`, `client.C0wFFCQs.js`), so a given URL's bytes
# can never change — a new build produces a new URL. Safe to cache forever.
# Without this block the asset layer's default applies
# (`public, max-age=0, must-revalidate`), which costs a conditional
# round-trip per script and stylesheet on every repeat visit even though the
# response is always a 304. Same reasoning as `/fonts/*` below; the fonts got
# the treatment first because they're the single biggest payload (~79 KB).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og/*.png
  Cache-Control: public, max-age=86400
